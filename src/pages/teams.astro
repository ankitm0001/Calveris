---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";

// ============================================================
// TEAM MEMBER DATA
// ============================================================

const placeholderNames = [
  "James Holden", "Naomi Nagata", "Amos Burton", "Alex Kamal", "Chrisjen Avasarala",
  "Bobbie Draper", "Josephus Miller", "Fred Johnson", "Julie Mao", "Anderson Dawes",
  "Clarissa Mao", "Marco Inaros", "Filip Inaros", "Camina Drummer", "Klaes Ashford",
  "Praxidike Meng", "Monica Stuart", "Anna Volovodov", "Elvi Okoye", "Fayez Sarkis",
  "Tilly Fagan", "Carlos c de Baca", "Michio Pa", "Carlos Bull", "Sam Rosenberg",
  "Hector Cortez", "Garrity", "Winston Duarte", "Teresa Duarte", "Santiago Singh"
];

const placeholderRoles = [
  "Delivery Lead",
  "Finance Operations",
  "Client Relations",
  "Accounts Manager",
  "Compliance",
  "Strategy & Reporting",
  "Systems & Technology"
];

const members = Array.from({ length: 30 }).map((_, i) => ({
  name: placeholderNames[i] ?? `[NAME]`,
  role: placeholderRoles[i % placeholderRoles.length],
  image: `https://i.pravatar.cc/600?img=${(i % 70) + 1}`,
  desc: i % 2 === 0 ? "Expert in corporate tax and strategic financial planning, ensuring meticulous compliance and robust oversight." : "Specializes in streamlining month-end processes, workflow automation, and uncovering financial anomalies."
}));
---

<Layout>
  <Navbar client:load />

  <main class="bg-[#e6e9ef] pt-[150px] pb-[160px] relative" style="background-image: radial-gradient(rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 20px 20px;">
    <div class="w-full max-w-[1400px] mx-auto px-6 md:px-8 xl:px-16">

      <!-- PAGE INTRO -->
      <section class="mb-[80px] max-w-[1200px] mx-auto reveal">
        <div class="eyebrow flex items-center gap-3 text-[#6b7280] mb-4">
          <span aria-hidden="true" class="inline-block size-[6px] rotate-45 bg-[#2a5a4a]"></span>
          OUR PEOPLE
        </div>
        <div class="mt-8 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 border-b border-black/10 pb-10">
          <h1 class="display-lg text-[#0d1b16] max-w-[700px]">The people behind the work.</h1>
          <p class="body-lg text-[#6b7280] max-w-[400px] lg:text-right lg:mb-1 shrink-0">
            Dependable finance functions are built by capable people, not just software.
          </p>
        </div>
      </section>

      <!-- TEAM GRID -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 xl:gap-8 max-w-[1400px] mx-auto">
        {members.map((member, index) => (
          <div class="group relative rounded-[2rem] bg-[#171a19] p-3 flex flex-col h-[420px] shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-white/5 overflow-hidden cursor-pointer transition-colors duration-300 hover:bg-[#1c201e]" style={`animation-delay: ${(index % 4) * 100}ms`}>
              <div class="relative w-full rounded-[1.5rem] overflow-hidden transition-[height] duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] h-[310px] group-hover:h-[220px] bg-[#2a302d] shrink-0">
                  <img 
                      src={member.image} 
                      alt={member.name}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </div>
              
              <div class="px-2 pt-4 flex flex-col flex-grow justify-start">
                  <div class="flex items-center justify-between mb-1">
                      <h3 class="text-xl text-white font-serif font-medium tracking-wide">{member.name}</h3>
                      <div class="mc-arrow flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-black/60 border border-white/14 transition-colors duration-300 group-hover:bg-black/85">
                        <svg class="mc-arrow-icon w-[13px] h-[13px] stroke-[rgba(244,242,236,0.92)] transition-transform duration-[450ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:rotate-180" viewBox="0 0 14 14" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 12 L12 2 M4 2 H12 V10" />
                        </svg>
                      </div>
                  </div>
                  <div class="text-[#9ca3af] text-sm font-light">
                      {member.role}
                  </div>
                  
                  <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]">
                      <div class="overflow-hidden">
                          <p class="text-[#d1d5db] text-sm leading-relaxed font-light pt-3 opacity-0 group-hover:opacity-100 transition-all duration-500 delay-75 transform translate-y-2 group-hover:translate-y-0">
                              {member.desc}
                          </p>
                      </div>
                  </div>
              </div>
          </div>
        ))}
      </section>

    </div>
  </main>

  <Footer />
</Layout>

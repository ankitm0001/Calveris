  <style>
    /* ── Belief Cards ───────────────────────────────────────────────── */

    /*
     * bg-secondary is a very slightly off-white.
     * The neumorphic shadows need contrast against the background,
     * so we use the same two-tone shadow system as .clay-card site-wide:
     *   dark shadow: bottom-right  (#c4c6cc / warm grey)
     *   light shadow: top-left     (#ffffff)
     */
    .belief-card {
      background: var(--color-background);
      border-radius: 2rem;
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 0;
      position: relative;
      overflow: hidden;
      /* Neumorphic raised — matches site-wide .clay-card exactly */
      box-shadow:
        18px 18px 36px #c4c6cc,
        -18px -18px 36px #ffffff;
      transition: box-shadow 0.4s ease, transform 0.4s ease;
      cursor: default;
    }

    .belief-card:hover {
      transform: translateY(-6px);
      box-shadow:
        24px 24px 48px #b8bac0,
        -24px -24px 48px #ffffff,
        inset 1px 1px 2px rgba(255, 255, 255, 0.8);
    }

    /* Icon wrapper — small neumorphic inset pill */
    .belief-icon-wrap {
      width: 52px;
      height: 52px;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.75rem;
      /* Neumorphic INSET — matches site-wide .clay-inset */
      box-shadow:
        inset 6px 6px 12px #c4c6cc,
        inset -6px -6px 12px #ffffff;
      background: var(--color-background);
      transition: box-shadow 0.3s ease;
    }

    .belief-card:hover .belief-icon-wrap {
      box-shadow:
        inset 8px 8px 16px #b8bac0,
        inset -8px -8px 16px #ffffff;
    }

    /* Number label */
    .belief-num {
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      font-weight: 700;
      text-transform: uppercase;
      color: rgba(42, 90, 74, 0.45);
      margin-bottom: 0.75rem;
    }

    /* Card heading */
    .belief-card-title {
      font-family: var(--font-display, Georgia, serif);
      font-size: clamp(1.05rem, 1.6vw, 1.25rem);
      font-weight: 600;
      line-height: 1.3;
      color: #0d1b16;
      margin-bottom: 1rem;
    }

    /* Card body copy */
    .belief-card-copy {
      font-size: 0.95rem;
      line-height: 1.75;
      color: #65665e;
      flex-grow: 1;
    }

    /* Accent bar at bottom — slides in on hover */
    .belief-accent-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      height: 3px;
      width: 0;
      background: linear-gradient(90deg, #2a5a4a, #7caa78);
      border-radius: 0 2px 0 0;
      transition: width 0.5s ease;
    }

    .belief-card:hover .belief-accent-bar {
      width: 100%;
    }
  </style>


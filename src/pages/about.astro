              <path id="flow-path-active" d="" stroke="#7caa78" stroke-width="3" fill="none" class="transition-all duration-1000 ease-out" />
            </svg>

            <div class="flex flex-col gap-12 relative z-10 w-full">

              <!-- Step 01 (Left) -->
              <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0 flow-step reveal">
                <div class="w-full md:w-1/2 flex md:justify-end md:pr-8">
                  <div class="w-full rounded-[2rem] p-2 flex items-center gap-4 clay-card group hover:-translate-y-1 transition-all duration-300">
                    <div class="flex-grow pl-5 py-2 text-md font-medium text-foreground">Business grows</div>
                    <div class="w-12 h-12 rounded-full clay-inset flex items-center justify-center shrink-0 flow-dot">
                      <div class="w-2.5 h-2.5 rounded-full bg-accent opacity-50 group-hover:opacity-100 transition-opacity shadow-[0_0_10px_rgba(124,170,120,0.5)]"></div>
                    </div>
                  </div>
                </div>
                <!-- Empty spacer to maintain layout -->
                <div class="hidden md:block w-1/2"></div>
              </div>

              <!-- Step 02 (Right) -->
              <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0 flow-step reveal">
                <!-- Empty spacer to maintain layout -->
                <div class="hidden md:block w-1/2"></div>
                <div class="w-full md:w-1/2 flex md:justify-start md:pl-8">
                  <div class="w-full rounded-[2rem] p-2 flex items-center flex-row-reverse md:flex-row gap-4 clay-card group hover:-translate-y-1 transition-all duration-300">
                    <div class="w-12 h-12 rounded-full clay-inset flex items-center justify-center shrink-0 flow-dot">
                      <div class="w-2.5 h-2.5 rounded-full bg-accent opacity-50 group-hover:opacity-100 transition-opacity shadow-[0_0_10px_rgba(124,170,120,0.5)]"></div>
                    </div>
                    <div class="flex-grow pr-5 md:pr-0 md:pl-2 py-2 text-md font-medium text-foreground text-right md:text-left">Accounting work grows</div>
                  </div>
                </div>
              </div>

              <!-- Step 03 (Left) -->
              <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0 flow-step reveal">
                <div class="w-full md:w-1/2 flex md:justify-end md:pr-8">
                  <div class="w-full rounded-[2rem] p-2 flex items-center gap-4 clay-card group hover:-translate-y-1 transition-all duration-300">
                    <div class="flex-grow pl-5 py-2 text-md font-medium text-foreground leading-snug">Existing capacity gets tight</div>
                    <div class="w-12 h-12 rounded-full clay-inset flex items-center justify-center shrink-0 flow-dot">
                      <div class="w-2.5 h-2.5 rounded-full bg-accent opacity-50 group-hover:opacity-100 transition-opacity shadow-[0_0_10px_rgba(124,170,120,0.5)]"></div>
                    </div>
                  </div>
                </div>
                <!-- Empty spacer to maintain layout -->
                <div class="hidden md:block w-1/2"></div>
              </div>

              <!-- Step 04 (Right) -->
              <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0 flow-step reveal relative">
                <!-- Empty spacer to maintain layout -->
                <div class="hidden md:block w-1/2"></div>
                <div class="w-full md:w-1/2 flex md:justify-start md:pl-8">
                  <div class="w-full rounded-[2rem] p-2 flex items-center flex-row-reverse md:flex-row gap-4 clay-card group hover:-translate-y-1 transition-all duration-300 border border-accent/20">
                    <div class="w-12 h-12 rounded-full clay-inset flex items-center justify-center shrink-0 flow-dot flow-dot-final relative">
                      <div class="absolute inset-0 rounded-full bg-accent opacity-20 animate-ping"></div>
                      <div class="w-3 h-3 rounded-full bg-accent shadow-[0_0_15px_rgba(124,170,120,0.8)] relative z-10"></div>
                    </div>
                    <div class="flex-grow pr-5 md:pr-0 md:pl-2 py-2 text-md font-medium text-foreground text-right md:text-left leading-snug">More capacity is needed</div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- The Climax / Fork -->
          <div class="w-full reveal mt-24 relative">
            
            <!-- Vertical line connecting Step 04 to the fork -->
            <div class="hidden lg:block absolute left-1/2 top-0 -translate-x-1/2 -mt-24 w-[2px] h-24 border-l-2 border-dashed border-accent/40 z-0"></div>

            <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-stretch gap-6 relative z-10">
              
              <!-- Horizontal line connecting A and B -->
              <div class="hidden lg:block absolute top-1/2 left-[20%] right-[20%] h-0 border-t-2 border-dashed border-accent/40 -z-10"></div>
              
              <!-- Option A -->
              <div class="rounded-3xl clay-inset p-6 flex flex-col hover:scale-[1.02] transition-transform bg-background">
                <div class="eyebrow text-muted-foreground/60 mb-2">OPTION A</div>
                <h3 class="text-lg font-medium text-muted-foreground mb-6 leading-tight">Build everything internally</h3>
                <div class="mt-auto flex items-center gap-2 text-[#c96a4a] bg-background clay-pressed w-fit px-3 py-1.5 rounded-full">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  <span class="text-[9px] tracking-widest uppercase font-bold">Absorbs resources</span>
                </div>
              </div>

              <!-- Divider -->
              <div class="font-display italic text-muted-foreground/50 text-xl flex items-center justify-center py-2 lg:py-0 bg-background px-4">or</div>

              <!-- Option B -->
              <div class="rounded-3xl dark-card p-6 flex flex-col relative overflow-hidden group hover:scale-[1.02] transition-transform cursor-pointer border border-[#2a5a4a]/30 hover:border-[#2a5a4a]">
                <div class="absolute top-0 right-0 w-24 h-24 bg-[#2a5a4a] rounded-full blur-[40px] opacity-40 -translate-y-1/2 translate-x-1/3 pointer-events-none group-hover:opacity-70 transition-opacity"></div>
                <div class="relative z-10 h-full flex flex-col">
                  <div class="eyebrow text-accent/70 mb-2">OPTION B</div>
                  <h3 class="text-lg font-medium text-white mb-6 leading-tight">Add the capacity you need</h3>
                  <div class="mt-auto flex items-center gap-2 text-accent bg-[#2a5a4a]/30 border border-[#2a5a4a] w-fit px-3 py-1.5 rounded-full backdrop-blur-sm">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span class="text-[9px] tracking-widest uppercase font-bold">Preserves resources</span>
                  </div>
                </div>
              </div>

            </div>

            <!-- Highlighted statement -->
            <div class="mt-16 max-w-2xl text-center mx-auto">
              <p class="font-display font-light italic leading-snug mb-5" style="font-size: clamp(1.6rem, 3vw, 2rem); color: #0d1b16;">
                Calveris exists for the second path.
              </p>
              <p class="text-[1rem] leading-relaxed text-muted-foreground">
                We provide the accounting capacity behind the work, so businesses can add what they need without automatically building an entire function around it.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Script for Serpentine SVG drawing and Scroll Animation -->
  <script>
    function drawSerpentineFlow() {
      const container = document.getElementById('serpentine-flow');
      const svg = document.getElementById('flow-svg');
      const pathBg = document.getElementById('flow-path-bg');
      const pathActive = document.getElementById('flow-path-active');
      const dots = document.querySelectorAll('.flow-dot');
      
      if (!container || !svg || dots.length < 2) return;

      // Ensure SVG is the exact size of the container
      svg.setAttribute('width', container.offsetWidth.toString());
      svg.setAttribute('height', container.offsetHeight.toString());

      // Get container bounds to calculate relative positions
      const containerRect = container.getBoundingClientRect();
      
      // Calculate center points of each dot relative to the container
      const points = Array.from(dots).map(dot => {
        const rect = dot.getBoundingClientRect();
        return {
          x: (rect.left + rect.width / 2) - containerRect.left,
          y: (rect.top + rect.height / 2) - containerRect.top
        };
      });

      // Construct SVG path data (S-curve)
      let d = `M ${points[0].x} ${points[0].y}`;
      
      for (let i = 0; i < points.length - 1; i++) {
        const current = points[i];
        const next = points[i + 1];
        
        // Control points for the bezier curve to create an S-shape
        // We extend the curve vertically to make it snake elegantly
        const midY = (current.y + next.y) / 2;
        
        d += ` C ${current.x} ${midY}, ${next.x} ${midY}, ${next.x} ${next.y}`;
      }

      // Apply path to both SVG elements
      pathBg.setAttribute('d', d);
      pathActive.setAttribute('d', d);

      // Setup Scroll Animation for the active line
      const pathLength = pathActive.getTotalLength();
      
      // Initial state: fully hidden
      pathActive.style.strokeDasharray = `${pathLength} ${pathLength}`;
      pathActive.style.strokeDashoffset = pathLength.toString();

      // Setup Intersection Observer to animate when in view
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Un-offset the dash to reveal the line
            pathActive.style.strokeDashoffset = '0';
            // Stop observing once animated
            observer.disconnect();
          }
        });
      }, { threshold: 0.3 });

      observer.observe(container);
    }

    function drawStoryFlow() {
      const container = document.getElementById('story-flow');
      const svg = document.getElementById('story-svg');
      const path = document.getElementById('story-path');
      const dots = document.querySelectorAll('.story-dot');
      
      if (!container || !svg || !path || dots.length < 2) return;

      svg.setAttribute('width', container.offsetWidth.toString());
      svg.setAttribute('height', container.offsetHeight.toString());

      const containerRect = container.getBoundingClientRect();
      const points = Array.from(dots).map(dot => {
        const rect = dot.getBoundingClientRect();
        return {
          x: (rect.left + rect.width / 2) - containerRect.left,
          y: (rect.top + rect.height / 2) - containerRect.top
        };
      });

      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 0; i < points.length - 1; i++) {
        const current = points[i];
        const next = points[i + 1];
        
        const midY = (current.y + next.y) / 2;
        d += ` C ${current.x} ${midY}, ${next.x} ${midY}, ${next.x} ${next.y}`;
      }

      path.setAttribute('d', d);

      const pathLength = path.getTotalLength();
      path.style.strokeDasharray = `${pathLength} ${pathLength}`;
      path.style.strokeDashoffset = pathLength.toString();

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            path.style.strokeDashoffset = '0';
            observer.disconnect();
          }
        });
      }, { threshold: 0.3 });

      observer.observe(container);
    }

    function initCountUp() {
      const counters = document.querySelectorAll('.count-up');
      if (counters.length === 0) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            if (el.classList.contains('counted')) return;
            el.classList.add('counted');
            
            const target = parseInt(el.getAttribute('data-val') || '0', 10);
            const duration = 2000;
            let startTimestamp = null;
            
            const step = (timestamp) => {
              if (!startTimestamp) startTimestamp = timestamp;
              const progress = Math.min((timestamp - startTimestamp) / duration, 1);
              const easeProgress = 1 - Math.pow(1 - progress, 4);
              el.innerText = Math.floor(easeProgress * target).toString();
              if (progress < 1) {
                window.requestAnimationFrame(step);
              } else {
                el.innerText = target.toString();
              }
            };
            window.requestAnimationFrame(step);
          }
        });
      }, { threshold: 0.1 });

      counters.forEach(counter => observer.observe(counter));
    }

    // Run on load and resize
    window.addEventListener('load', () => { drawSerpentineFlow(); drawStoryFlow(); initCountUp(); });
    window.addEventListener('resize', () => { drawSerpentineFlow(); drawStoryFlow(); });
    document.addEventListener('astro:page-load', () => { drawSerpentineFlow(); drawStoryFlow(); initCountUp(); });
  </script>

  <!-- ================================================================
       SECTION 03 — OUR STORY
  ================================================================ -->
  <section class="bg-background py-28 lg:py-40 border-b border-hairline">
    <div class="shell">
      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start mb-16">
        
        <!-- Left Side: Narrative and Bullet Points -->
        <div class="lg:col-span-6 reveal">
          <div class="about-eyebrow-light mb-6">How we got here</div>
          <h2
            class="font-display font-light leading-[1.15] mb-12"
            style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;"
          >
            We didn't start with a model.<br />
            <span style="color: #65665e;">We started with the work.</span>
          </h2>
          
          <p
            class="text-[1.05rem] leading-relaxed mb-6"
            style="color: #65665e;"
          >
            Accounting work has a way of revealing what a business actually
            needs.
          </p>
          
          <ul class="text-[1.05rem] leading-relaxed mb-8 list-none space-y-4" style="color: #65665e;">
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1.5 text-xs">◆</span>
              <span>More work creates pressure on existing teams.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1.5 text-xs">◆</span>
              <span>More clients create more deadlines.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1.5 text-xs">◆</span>
              <span>As volume increases, <span class="brand-highlight">adding capacity becomes just as important as doing the work itself.</span></span>
            </li>
          </ul>

          <p
            class="text-[1.05rem] leading-relaxed font-medium"
            style="color: #0d1b16;"
          >
            Calveris grew around that reality.
          </p>
        </div>

        <!-- Right Side: Vertical Wavy Flow -->
        <div class="lg:col-span-6 lg:col-start-7 reveal">
          <div class="relative w-full pb-12 mt-4 lg:mt-0" id="story-flow">
            
            <!-- SVG Canvas for the connecting line -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none z-20" id="story-svg">
              <path id="story-path" d="" stroke="rgba(126, 200, 160, 0.4)" stroke-width="2" fill="none" class="transition-all duration-1000 ease-out" />
            </svg>

            <div class="flex flex-col gap-20 relative z-10 w-full">
              
              <!-- Step 01 (Right Text) -->
              <div class="flex items-center w-full relative group">
                <!-- Huge Faded Number -->
                <div class="absolute left-0 top-1/2 -translate-y-1/2 text-[10rem] font-display font-light text-[#0d1b16]/[0.03] -z-10 leading-none select-none transition-transform group-hover:scale-110 duration-700">1</div>
                
                <div class="w-[35%] flex justify-end pr-4 sm:pr-8">
                  <!-- Node on curve -->
                  <div class="w-12 h-12 shrink-0 clay-inset rounded-xl flex items-center justify-center story-dot relative z-10 rotate-45 group-hover:-translate-y-1 transition-transform">
                    <div class="w-3 h-3 bg-accent rounded-sm -rotate-45 shadow-[0_0_10px_rgba(124,170,120,0.5)]"></div>
                  </div>
                </div>
                
                <div class="w-[65%] pl-2 sm:pl-4">
                  <div class="clay-card rounded-[2rem] p-5 sm:p-6 max-w-sm">
                    <h3 class="font-display text-xl text-[#0d1b16] mb-2">The Work</h3>
                    <p class="text-[0.95rem] text-[#65665e] leading-relaxed">
                      Real accounting requirements came first. We learned by handling the
                      work businesses and accounting professionals actually needed.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Step 02 (Left Text) -->
              <div class="flex items-center w-full relative group">
                <div class="absolute right-0 top-1/2 -translate-y-1/2 text-[10rem] font-display font-light text-[#0d1b16]/[0.03] -z-10 leading-none select-none transition-transform group-hover:scale-110 duration-700">2</div>
                
                <div class="w-[65%] pr-2 sm:pr-4 text-right flex justify-end">
                  <div class="clay-card rounded-[2rem] p-5 sm:p-6 max-w-sm">
                    <h3 class="font-display text-xl text-[#0d1b16] mb-2">The Capacity</h3>
                    <p class="text-[0.95rem] text-[#65665e] leading-relaxed">
                      More work required more than individual effort. People, experience
                      and delivery systems had to grow with the workload.
                    </p>
                  </div>
                </div>
                
                <div class="w-[35%] flex justify-start pl-4 sm:pl-8">
                  <!-- Node on curve -->
                  <div class="w-12 h-12 shrink-0 clay-inset rounded-xl flex items-center justify-center story-dot relative z-10 rotate-45 group-hover:-translate-y-1 transition-transform">
                    <div class="w-3 h-3 bg-accent rounded-sm -rotate-45 shadow-[0_0_10px_rgba(124,170,120,0.5)]"></div>
                  </div>
                </div>
              </div>

              <!-- Step 03 (Right Text) -->
              <div class="flex items-center w-full relative group">
                <div class="absolute left-0 top-1/2 -translate-y-1/2 text-[10rem] font-display font-light text-[#0d1b16]/[0.03] -z-10 leading-none select-none transition-transform group-hover:scale-110 duration-700">3</div>
                
                <div class="w-[35%] flex justify-end pr-4 sm:pr-8">
                  <div class="w-12 h-12 shrink-0 clay-inset rounded-xl flex items-center justify-center story-dot relative z-10 rotate-45 group-hover:-translate-y-1 transition-transform">
                    <div class="w-3 h-3 bg-accent rounded-sm -rotate-45 shadow-[0_0_10px_rgba(124,170,120,0.8)]"></div>
                  </div>
                </div>
                
                <div class="w-[65%] pl-2 sm:pl-4">
                  <div class="bg-[#0d1b16] text-white rounded-[2rem] p-5 sm:p-6 max-w-sm" style="box-shadow: 12px 12px 24px rgba(0,0,0,0.1), -12px -12px 24px rgba(255,255,255,0.7), inset 1px 1px 2px rgba(255, 255, 255, 0.1), inset -1px -1px 2px rgba(0, 0, 0, 0.2);">
                    <h3 class="font-display text-xl text-white mb-2">Calveris</h3>
                    <p class="text-[0.95rem] text-white/70 leading-relaxed">
                      The experience became a model. A dedicated accounting delivery
                      partner built to provide capacity around the way businesses already
                      work.
                    </p>
                  </div>
                </div>
              </div>
              
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Middle Text -->
      <div class="max-w-2xl mx-auto text-center reveal mt-4">
        <p class="text-[1.1rem] leading-relaxed font-medium" style="color: #65665e;">
          We built the people, processes and delivery structure required to handle the work reliably, then kept building as the work grew.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================================
       SECTION 04 — WHAT WE HAVE BUILT (dark)
  ================================================================ -->
  <section
    class="about-dark-section py-28 lg:py-40 border-b border-[#183329]/40"
  >
    <div class="shell">
      <div class="reveal mb-20">
        <div class="about-eyebrow-dark mb-6">Built through delivery</div>
        <h2
          class="font-display font-light leading-[1.15]"
          style="font-size: clamp(2rem, 4vw, 3rem); color: #f0f5f0;"
        >

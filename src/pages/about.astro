  <script>
    function setupTeamScroll() {
      const container = document.getElementById('team-scroll-container');
      const leftBtn = document.getElementById('team-scroll-left');
      const rightBtn = document.getElementById('team-scroll-right');

      if (!container || !leftBtn || !rightBtn) return;

      leftBtn.addEventListener('click', () => {
        container.scrollBy({ left: -350, behavior: 'smooth' });
      });

      rightBtn.addEventListener('click', () => {
        container.scrollBy({ left: 350, behavior: 'smooth' });
      });
    }

    // Run on standard load and Astro view transitions
    window.addEventListener('load', setupTeamScroll);
    document.addEventListener('astro:page-load', setupTeamScroll);
  </script>


---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import Testimonials from "../components/Testimonials.astro";

const placeholderNames = [
  "James Holden", "Naomi Nagata", "Amos Burton", "Alex Kamal", "Chrisjen Avasarala",
  "Bobbie Draper", "Josephus Miller", "Fred Johnson"
];

const placeholderRoles = [
  "Delivery Lead", "Finance Operations", "Client Relations", "Accounts Manager",
  "Compliance", "Strategy & Reporting", "Systems & Technology"
];

const previewMembers = Array.from({ length: 8 }).map((_, i) => ({
  name: placeholderNames[i],
  role: placeholderRoles[i % placeholderRoles.length],
  image: `https://i.pravatar.cc/600?img=${(i % 70) + 1}`,
  desc: i % 2 === 0 ? "Expert in corporate tax and strategic financial planning, ensuring meticulous compliance and robust oversight." : "Specializes in streamlining month-end processes, workflow automation, and uncovering financial anomalies."
}));
---

<Layout>
  <Navbar client:load />

  <!-- ================================================================
       SECTION 01 — HERO
  ================================================================ -->
  <header class="about-hero relative overflow-hidden flex flex-col" id="top">
    <!-- Background image -->
    <div class="about-hero-bg" aria-hidden="true"></div>
    <!-- Gradient overlay: fades from transparent at top to off-white at bottom for section blend -->
    <div class="about-hero-gradient" aria-hidden="true"></div>

    <main
      class="flex flex-col justify-center shell relative z-10 pt-[140px] pb-24"
    >
      <div
        class="w-full h-px mb-14"
        style="background: rgba(42,90,74,0.15);"
      >
      </div>

      <!-- Eyebrow -->
      <div
        class="inline-flex w-fit items-center gap-2 px-6 py-2.5 rounded-full text-[9px] tracking-widest uppercase font-bold mb-10 about-eyebrow opacity-0 a-fade-in"
        style="animation-delay: 0.15s;"
      >
        <span
          aria-hidden="true"
          class="inline-block size-[6px] rotate-45"
          style="background: #7caa78;"
        ></span>
        <span>About Calveris</span>
      </div>

      <div class="max-w-5xl">
        <h1
          class="font-display leading-[1.1] font-light"
          style="font-size: clamp(2.5rem, 5vw, 4.5rem); color: #0d1b16;"
        >
          <span class="block opacity-0 a-fade-in" style="animation-delay: 0.3s;"
            >Nothing should hold back</span
          >
          <span class="reveal-mask block">
            <span
              class="block italic opacity-0 a-reveal-up"
              style="animation-delay: 0.5s; color: #2a5a4a;"
              >a business built to grow.</span
            >
          </span>
        </h1>

        <p
          class="mt-10 max-w-lg text-[1.1rem] leading-relaxed opacity-0 a-fade-in font-medium"
          style="animation-delay: 0.9s; color: #0d1b16;"
        >
          We provide the accounting capacity to keep growth moving.
        </p>
      </div>
    </main>
  </header>

  <!-- ================================================================
       SECTION 02 — WHY WE EXIST
  ================================================================ -->
  <section class="why-section bg-background py-24 lg:py-36 border-b border-hairline">
    <div class="shell">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
        
        <!-- Left: Header -->
        <div class="lg:col-span-5 lg:sticky top-40 reveal">
          <div class="inline-flex w-fit items-center gap-2 px-6 py-2.5 rounded-full text-[9px] tracking-widest uppercase font-bold mb-6 about-eyebrow">
            <span aria-hidden="true" class="inline-block size-[6px] rotate-45" style="background: #7caa78;"></span>
            <span>Why we exist</span>
          </div>
          <h2 class="display-lg text-balance leading-[1.1]">
            Growth should create more opportunity,
            <em class="not-italic italic font-light text-muted-foreground block mt-2">not more accounting overhead.</em>
          </h2>
        </div>

        <!-- Right: Flow and Fork -->
        <div class="lg:col-span-7">
          
          <!-- Serpentine Flow Container -->
          <div class="relative w-full mb-24" id="serpentine-flow">
            
            <!-- SVG Canvas for the connecting line -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" id="flow-svg">

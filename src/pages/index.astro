---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import Workload from "../components/Workload.astro";
import CapacityTradeoff from "../components/CapacityTradeoff.astro";
import Model from "../components/Model";
import Founders from "../components/Founders.astro";
import Services from "../components/Services";
import Relationships from "../components/Relationships.astro";
import Scale from "../components/Scale.astro";
import Controls from "../components/Controls.astro";
import Pilot from "../components/Pilot.astro";
import CTA from "../components/CTA.astro";
import Build from "../components/Build";
import FAQ from "../components/FAQ";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar client:load />
  <Hero />
  <Workload />
  <CapacityTradeoff />
  <Model client:load />
  <Services client:load />
  <Relationships />
  <Scale />
  <Controls />
  <Founders />
  <Pilot />
  <CTA />
  <FAQ client:visible />
  <Footer />
</Layout>

<script>
  // ── Scroll reveal ──────────────────────────────
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -10% 0px' });

  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

  // Add the CSS for .reveal transitions
  const style = document.createElement('style');
  style.textContent = `
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.revealed { opacity: 1; transform: translateY(0); }
  `;
  document.head.appendChild(style);


  // ── Service Carousel ──────────────────────────
  (() => {
    const track = document.getElementById('svc-track');
    const prevBtn = document.getElementById('svc-prev');
    const nextBtn = document.getElementById('svc-next');
    const dots = document.querySelectorAll('.svc-dot');
    const cards = document.querySelectorAll('.svc-card');
    const total = cards.length;
    let current = 0;

    function goTo(index) {
      const oldIndex = current;
      current = Math.max(0, Math.min(total - 1, index));
      
      cards.forEach((c, i) => {
        c.className = 'svc-card';
        if (i === current) {
          c.classList.add('active');
        } else if (i === current + 1) {
          c.classList.add('next-1');
        } else if (i === current + 2) {
          c.classList.add('next-2');
        } else if (i < current) {
          c.classList.add('inactive-up');
        }
      });

      dots.forEach((d, i) => {
        d.classList.toggle('svc-dot-active', i === current);
      });
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goTo(i));
    });

    // Touch/swipe support (vertical and horizontal)
    let touchStartX = 0;
    let touchStartY = 0;
    track.addEventListener('touchstart', e => { 
      touchStartX = e.changedTouches[0].screenX; 
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });
    
    track.addEventListener('touchend', e => {
      const diffX = touchStartX - e.changedTouches[0].screenX;
      const diffY = touchStartY - e.changedTouches[0].screenY;
      
      if (Math.abs(diffY) > Math.abs(diffX)) {
        if (Math.abs(diffY) > 50) goTo(diffY > 0 ? current + 1 : current - 1);
      } else {
        if (Math.abs(diffX) > 50) goTo(diffX > 0 ? current + 1 : current - 1);
      }
    });

    goTo(0);
  })();
</script>

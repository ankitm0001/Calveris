---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar client:load />

  <!-- ================================================================
       SECTION 01 — HERO
  ================================================================ -->
  <header
    class="services-hero relative flex flex-col"
    id="top"
    style="overflow: visible;"
  >
    <div class="services-hero-bg" aria-hidden="true"></div>
    <div class="services-hero-gradient" aria-hidden="true"></div>

    <!-- Hero image — absolutely positioned, bleeds into navbar -->
    <div
      class="absolute opacity-0 a-fade-in pointer-events-none"
      style="top: -25px; right: 4%; width: 38%; z-index: 6; animation-delay: 0.6s;"
    >
      <img
        src="/images/services-hero-right.png"
        alt="Calveris connected accounting services journey"
        class="w-full object-contain"
      />
    </div>

    <main
      class="flex flex-col justify-center shell relative pt-[140px] pb-24"
      style="z-index: 10;"
    >
      <div class="w-full h-px mb-14" style="background: rgba(42,90,74,0.15);">
      </div>

      <!-- Eyebrow -->
      <div
        class="inline-flex w-fit items-center gap-2 px-6 py-2.5 rounded-full text-[9px] tracking-widest uppercase font-bold mb-10 about-eyebrow opacity-0 a-fade-in"
        style="animation-delay: 0.15s;"
      >
        <span
          aria-hidden="true"
          class="inline-block size-[6px] rotate-45"
          style="background: #7caa78;"></span>
        <span>Our Services</span>
      </div>

      <div class="max-w-xl">
        <h1
          class="font-display leading-[1.1] font-light"
          style="font-size: clamp(2.5rem, 5vw, 4.5rem); color: #0d1b16;"
        >
          <span class="block opacity-0 a-fade-in" style="animation-delay: 0.3s;"
            >The accounting work</span
          >
          <span class="reveal-mask block">
            <span
              class="block italic opacity-0 a-reveal-up"
              style="animation-delay: 0.5s; color: #2a5a4a;"
              >your business needs handled.</span
            >
          </span>
        </h1>

        <p
          class="mt-8 max-w-lg text-[1.1rem] leading-relaxed opacity-0 a-fade-in font-medium"
          style="animation-delay: 0.9s; color: #0d1b16;"
        >
          From day-to-day bookkeeping to month-end, reporting, year-end and
          audit support, Calveris provides the accounting capacity to keep your
          work moving.
        </p>

        <div class="mt-12 opacity-0 a-fade-in" style="animation-delay: 1.1s;">
          <a
            href="/contact"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full text-[11px] tracking-[0.18em] uppercase font-bold transition-all duration-300 services-cta-btn"
          >
            Build your team
            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
              >→</span
            >
          </a>
        </div>
      </div>
    </main>
  </header>

  <!-- ================================================================
       SECTION 02 — SERVICE CAROUSEL
  ================================================================ -->
  <section
    class="bg-background py-24 lg:py-36 border-b border-hairline overflow-hidden"
    id="service-overview"
  >
    <div class="shell">
      <!-- Section Header -->
      <div class="reveal mb-16 text-center">
        <div class="about-eyebrow-light mb-6 mx-auto">Accounting Delivery</div>
        <h2
          class="font-display font-light leading-[1.1] mb-4"
          style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;"
        >
          One team for the accounting work that needs doing.
        </h2>
        <p
          class="text-[1rem] leading-relaxed max-w-xl mx-auto"
          style="color: #65665e;"
        >
          Choose the work you need handled. We build the right accounting
          capacity around it.
        </p>
      </div>

      <!-- Carousel Wrapper -->
      <div class="relative reveal">
        <!-- Nav Arrows -->
        <button
          id="svc-prev"
          aria-label="Previous service"
          class="svc-arrow svc-arrow-up"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="18 15 12 9 6 15"></polyline></svg
          >
        </button>
        <button
          id="svc-next"
          aria-label="Next service"
          class="svc-arrow svc-arrow-down"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="6 9 12 15 18 9"></polyline></svg
          >
        </button>

        <!-- Track -->
        <div class="svc-track-outer">
          <div id="svc-track" class="svc-track">
            <!-- CARD 01 — BOOKKEEPING -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">01 / Bookkeeping</div>
                  <h3 class="svc-heading">Keep the books moving.</h3>
                  <p class="svc-sub">
                    Accurate, up-to-date bookkeeping gives everything downstream
                    a cleaner starting point.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li>
                        <span class="svc-bullet">›</span>Transaction recording
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Bank reconciliations
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Ledger maintenance
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Bookkeeping support
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Ongoing bookkeeping
                        requirements
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      Your books stay current without your existing team having
                      to carry every transaction internally.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"
                        ></path><path
                          d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"
                        ></path></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 02 — PAYROLL -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">02 / Payroll</div>
                  <h3 class="svc-heading">
                    Payroll handled properly, every pay cycle.
                  </h3>
                  <p class="svc-sub">
                    Keep payroll moving accurately and on schedule without
                    adding another recurring responsibility to your internal
                    team.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li>
                        <span class="svc-bullet">›</span>Payroll processing
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Payroll administration
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Recurring payroll
                        requirements
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Supporting payroll
                        records
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      A recurring function gets handled consistently while your
                      team stays focused on higher-value work.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect width="20" height="12" x="2" y="6" rx="2"
                        ></rect><circle cx="12" cy="12" r="2"></circle><path
                          d="M6 12h.01M18 12h.01"></path></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 03 — MONTH-END -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">03 / Month-end</div>
                  <h3 class="svc-heading">
                    Close the month without carrying it forward.
                  </h3>
                  <p class="svc-sub">
                    Month-end work shouldn't become a growing backlog for an
                    already stretched team.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Month-end close</li>
                      <li><span class="svc-bullet">›</span>Reconciliations</li>
                      <li><span class="svc-bullet">›</span>Journal support</li>
                      <li>
                        <span class="svc-bullet">›</span>Period-end accounting
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Supporting schedules
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      The month gets closed, the records stay current, and the
                      next period starts from a clean position.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
                          width="18"
                          height="18"
                          x="3"
                          y="4"
                          rx="2"></rect><path d="M3 10h18"></path><path
                          d="M8 14h.01"></path><path d="M12 14h.01"></path><path
                          d="M16 14h.01"></path><path d="M8 18h.01"></path><path
                          d="M12 18h.01"></path><path d="M16 18h.01"
                        ></path></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 04 — PAYABLES & RECEIVABLES -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">04 / Payables & Receivables</div>
                  <h3 class="svc-heading">
                    Keep money moving in both directions.
                  </h3>
                  <p class="svc-sub">
                    The work behind paying suppliers and keeping receivables
                    organised can become a significant operational load as the
                    business grows.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Accounts payable</li>
                      <li>
                        <span class="svc-bullet">›</span>Accounts receivable
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Invoice processing
                      </li>
                      <li><span class="svc-bullet">›</span>Supplier records</li>
                      <li>
                        <span class="svc-bullet">›</span>Customer account
                        support
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Reconciliation support
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      Routine financial operations keep moving without requiring
                      your internal team to carry the entire workload.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"
                        ></path><path d="m8 21-4-4 4-4"></path><path
                          d="M4 17h16"></path></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 05 — MANAGEMENT REPORTING -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">05 / Management Reporting</div>
                  <h3 class="svc-heading">
                    Turn completed accounts into useful information.
                  </h3>
                  <p class="svc-sub">
                    Management reporting gives the business a clearer view of
                    what has happened, and gives the people responsible for
                    decisions the information they need.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li>
                        <span class="svc-bullet">›</span>Management accounts
                      </li>
                      <li><span class="svc-bullet">›</span>Reporting packs</li>
                      <li>
                        <span class="svc-bullet">›</span>Supporting schedules
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Regular reporting
                        requirements
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Financial information
                        preparation
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      Your reporting is prepared consistently, so the people
                      using it can spend their time interpreting the numbers
                      rather than preparing them.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><line x1="18" x2="18" y1="20" y2="10"></line><line
                          x1="12"
                          x2="12"
                          y1="20"
                          y2="4"></line><line x1="6" x2="6" y1="20" y2="14"
                        ></line></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 06 — YEAR-END & TAX SUPPORT -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">06 / Year-end & Tax Support</div>
                  <h3 class="svc-heading">
                    Get year-end work off the backlog.
                  </h3>
                  <p class="svc-sub">
                    Year-end brings another layer of accounting work. We provide
                    the capacity to keep that work moving alongside your regular
                    accounting requirements.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li>
                        <span class="svc-bullet">›</span>Year-end accounting
                        support
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Accounts preparation
                        support
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Supporting schedules
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Tax-related accounting
                        support
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Information preparation
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      Your year-end workload has additional capacity behind it
                      when your existing team needs it most.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><line x1="3" x2="21" y1="22" y2="22"></line><line
                          x1="6"
                          x2="6"
                          y1="18"
                          y2="11"></line><line x1="10" x2="10" y1="18" y2="11"
                        ></line><line x1="14" x2="14" y1="18" y2="11"
                        ></line><line x1="18" x2="18" y1="18" y2="11"
                        ></line><polygon points="12 2 20 7 4 7"></polygon></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 07 — AUDIT SUPPORT -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">07 / Audit Support</div>
                  <h3 class="svc-heading">
                    Be ready when the audit work begins.
                  </h3>
                  <p class="svc-sub">
                    Audit preparation can pull significant time from an already
                    busy accounting team. We provide the additional capacity
                    needed to keep the underlying work organised and moving.
                  </p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li>
                        <span class="svc-bullet">›</span>Audit preparation
                        support
                      </li>
                      <li>
                        <span class="svc-bullet">›</span>Supporting schedules
                      </li>
                      <li><span class="svc-bullet">›</span>Documentation</li>
                      <li><span class="svc-bullet">›</span>Reconciliations</li>
                      <li>
                        <span class="svc-bullet">›</span>Information gathering
                        and preparation
                      </li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">
                      Your team spends less time assembling the underlying
                      accounting work and more time dealing with what actually
                      requires their attention.
                    </p>
                    <div class="svc-card-icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="64"
                        height="64"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="m8 11 2 2 4-4"></path><circle
                          cx="11"
                          cy="11"
                          r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div><!-- /svc-track -->
        </div><!-- /svc-track-outer -->

        <!-- Dot Indicators -->
        <div id="svc-dots" class="svc-dots">
          <button
            class="svc-dot svc-dot-active"
            data-index="0"
            aria-label="Service 1"></button>
          <button class="svc-dot" data-index="1" aria-label="Service 2"
          ></button>
          <button class="svc-dot" data-index="2" aria-label="Service 3"
          ></button>
          <button class="svc-dot" data-index="3" aria-label="Service 4"
          ></button>
          <button class="svc-dot" data-index="4" aria-label="Service 5"
          ></button>
          <button class="svc-dot" data-index="5" aria-label="Service 6"
          ></button>
          <button class="svc-dot" data-index="6" aria-label="Service 7"
          ></button>
        </div>
      </div><!-- /relative -->
    </div><!-- /shell -->
  </section>

  <!-- ================================================================
       SECTION 10 — NOT A PACKAGE
  ================================================================ -->
  <section class="bg-background py-24 lg:py-36 border-b border-hairline">
    <div class="shell">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-center"
      >
        <!-- Left -->
        <div class="lg:col-span-5 reveal">
          <div class="about-eyebrow-light mb-6">Built around the work</div>
          <h2
            class="font-display font-light leading-[1.1] mb-6"
            style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;"
          >
            You don't have to hand over everything.
          </h2>
          <ul
            class="text-[1rem] leading-relaxed mb-6 list-disc list-inside space-y-2"
            style="color: #65665e;"
          >
            <li>Some businesses need day-to-day accounting handled.</li>
            <li>
              Others need additional capacity around month-end, year-end or a
              particular part of the function.
            </li>
          </ul>
          <p class="text-[1rem] leading-relaxed" style="color: #65665e;">
            Calveris can work around the requirement rather than forcing every
            business into the same package.
          </p>
          <div
            class="mt-10 pt-8 text-[0.9rem] leading-relaxed text-muted-foreground border-t border-hairline"
          >
            A single requirement. A defined workstream. Or additional accounting
            capacity across the function.
          </div>
        </div>

        <!-- Right: Visual flow -->
        <div class="lg:col-span-7 reveal">
          <div
            class="relative w-full max-w-lg mx-auto lg:mx-0 py-4"
            id="serpentine-flow"
          >
            <!-- SVG Canvas for the connecting line -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none z-0"
              id="flow-svg"
            >
              <path
                id="flow-path-bg"
                d=""
                stroke="rgba(126, 200, 160, 0.3)"
                stroke-width="2"
                stroke-dasharray="6 6"
                fill="none"></path>
              <path
                id="flow-path-active"
                d=""
                stroke="#7caa78"
                stroke-width="3"
                fill="none"
                class="transition-all duration-1000 ease-out"></path>
            </svg>

            <div class="flex flex-col gap-12 relative z-10 w-full">
              <!-- Step 01 (Left) -->
              <div
                class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0 flow-step reveal"
              >
                <div class="w-full md:w-[55%] flex md:justify-end md:pr-4">
                  <div
                    class="w-full rounded-[2rem] p-2 flex items-center gap-4 clay-flow-card group hover:-translate-y-1 transition-all duration-300"
                  >
                    <div
                      class="flex-grow pl-5 py-2 text-[1.1rem] font-medium text-foreground"
                    >
                      One function
                    </div>
                    <div
                      class="w-12 h-12 rounded-full clay-flow-dot flex items-center justify-center shrink-0 flow-dot"
                    >
                      <div
                        class="w-2.5 h-2.5 rounded-full bg-accent opacity-50 group-hover:opacity-100 transition-opacity shadow-[0_0_10px_rgba(124,170,120,0.5)]"
                      >
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Empty spacer to maintain layout -->
                <div class="hidden md:block md:w-[45%]"></div>
              </div>

              <!-- Step 02 (Right) -->
              <div
                class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0 flow-step reveal"
              >
                <!-- Empty spacer to maintain layout -->
                <div class="hidden md:block md:w-[45%]"></div>
                <div class="w-full md:w-[55%] flex md:justify-start md:pl-4">
                  <div

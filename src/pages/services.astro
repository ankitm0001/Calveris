</style>

<script>
  // ── Scroll reveal ──────────────────────────────
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { rootMargin: "0px 0px -10% 0px" },
  );

  document
    .querySelectorAll(".reveal")
    .forEach((el) => revealObserver.observe(el));

  // Add the CSS for .reveal transitions
  const style = document.createElement("style");
  style.textContent = `
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.revealed { opacity: 1; transform: translateY(0); }
  `;
  document.head.appendChild(style);

  // ── Service Carousel ──────────────────────────
  (() => {
    const track = document.getElementById("svc-track");
    const prevBtn = document.getElementById("svc-prev");
    const nextBtn = document.getElementById("svc-next");
    const dots = document.querySelectorAll(".svc-dot");
    const cards = document.querySelectorAll(".svc-card");
    const total = cards.length;
    let current = 0;

    function goTo(index) {
      const oldIndex = current;
      current = Math.max(0, Math.min(total - 1, index));

      cards.forEach((c, i) => {
        c.className = "svc-card";
        if (i === current) {
          c.classList.add("active");
        } else if (i === current + 1) {
          c.classList.add("next-1");
        } else if (i === current + 2) {
          c.classList.add("next-2");
        } else if (i < current) {
          c.classList.add("inactive-up");
        }
      });

      dots.forEach((d, i) => {
        d.classList.toggle("svc-dot-active", i === current);
      });
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;
    }

    prevBtn.addEventListener("click", () => goTo(current - 1));
    nextBtn.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => goTo(i));
    });

    // Touch/swipe support (vertical and horizontal)
    let touchStartX = 0;
    let touchStartY = 0;
    track.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      },
      { passive: true },
    );

    track.addEventListener("touchend", (e) => {
      const diffX = touchStartX - e.changedTouches[0].screenX;
      const diffY = touchStartY - e.changedTouches[0].screenY;

      if (Math.abs(diffY) > Math.abs(diffX)) {
        if (Math.abs(diffY) > 50) goTo(diffY > 0 ? current + 1 : current - 1);
      } else {
        if (Math.abs(diffX) > 50) goTo(diffX > 0 ? current + 1 : current - 1);
      }
    });

    goTo(0);
  })();

  // ── Serpentine Flow ─────────────────────────────
  function drawSerpentineFlow() {
    const container = document.getElementById("serpentine-flow");
    const svg = document.getElementById("flow-svg");
    const pathBg = document.getElementById("flow-path-bg");
    const pathActive = document.getElementById("flow-path-active");
    const dots = document.querySelectorAll(".flow-dot");

    if (!container || !svg || dots.length < 2) return;

    svg.setAttribute("width", container.offsetWidth.toString());
    svg.setAttribute("height", container.offsetHeight.toString());

    const containerRect = container.getBoundingClientRect();

    const points = Array.from(dots).map((dot) => {
      const rect = dot.getBoundingClientRect();
      return {
        x: rect.left + rect.width / 2 - containerRect.left,
        y: rect.top + rect.height / 2 - containerRect.top,
      };
    });

    let d = `M ${points[0].x} ${points[0].y}`;

    for (let i = 0; i < points.length - 1; i++) {
      const current = points[i];
      const next = points[i + 1];
      const midY = (current.y + next.y) / 2;
      d += ` C ${current.x} ${midY}, ${next.x} ${midY}, ${next.x} ${next.y}`;
    }

    pathBg.setAttribute("d", d);
    pathActive.setAttribute("d", d);

    const pathLength = pathActive.getTotalLength();
    pathActive.style.strokeDasharray = `${pathLength} ${pathLength}`;
    pathActive.style.strokeDashoffset = pathLength.toString();

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            pathActive.style.strokeDashoffset = "0";
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );

    observer.observe(container);
  }

  window.addEventListener("load", drawSerpentineFlow);
  window.addEventListener("resize", drawSerpentineFlow);
  setTimeout(drawSerpentineFlow, 500);
  setTimeout(drawSerpentineFlow, 1500);
</script>

---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar client:load />

  <!-- ================================================================
       SECTION 01 — HERO
  ================================================================ -->
  <header class="services-hero relative overflow-hidden flex flex-col" id="top">
    <div class="services-hero-bg" aria-hidden="true"></div>
    <div class="services-hero-gradient" aria-hidden="true"></div>

    <main class="flex flex-col justify-center shell relative z-10 pt-[140px] pb-24">
      <div class="w-full h-px mb-14" style="background: rgba(42,90,74,0.15);"></div>

      <!-- Eyebrow -->
      <div
        class="inline-flex w-fit items-center gap-2 px-6 py-2.5 rounded-full text-[9px] tracking-widest uppercase font-bold mb-10 about-eyebrow opacity-0 a-fade-in"
        style="animation-delay: 0.15s;"
      >
        <span aria-hidden="true" class="inline-block size-[6px] rotate-45" style="background: #7caa78;"></span>
        <span>Our Services</span>
      </div>

      <div class="max-w-5xl">
        <h1
          class="font-display leading-[1.1] font-light"
          style="font-size: clamp(2.5rem, 5vw, 4.5rem); color: #0d1b16;"
        >
          <span class="block opacity-0 a-fade-in" style="animation-delay: 0.3s;">The accounting work</span>
          <span class="reveal-mask block">
            <span
              class="block italic opacity-0 a-reveal-up"
              style="animation-delay: 0.5s; color: #2a5a4a;"
            >your business needs handled.</span>
          </span>
        </h1>

        <p
          class="mt-10 max-w-2xl text-[1.1rem] leading-relaxed opacity-0 a-fade-in font-medium"
          style="animation-delay: 0.9s; color: #0d1b16;"
        >
          From day-to-day bookkeeping to month-end, reporting, year-end and audit support, Calveris provides the accounting capacity to keep your work moving.
        </p>

        <div class="mt-12 opacity-0 a-fade-in" style="animation-delay: 1.1s;">
          <a
            href="/contact"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full text-[11px] tracking-[0.18em] uppercase font-bold transition-all duration-300 services-cta-btn"
          >
            Build your team
            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </main>
  </header>

  <!-- ================================================================
       SECTION 02 — SERVICE CAROUSEL
  ================================================================ -->
  <section class="bg-background py-24 lg:py-36 border-b border-hairline overflow-hidden" id="service-overview">
    <div class="shell">

      <!-- Section Header -->
      <div class="reveal mb-16 text-center">
        <div class="about-eyebrow-light mb-6 mx-auto">Accounting Delivery</div>
        <h2 class="font-display font-light leading-[1.1] mb-4" style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;">
          One team for the accounting work that needs doing.
        </h2>
        <p class="text-[1rem] leading-relaxed max-w-xl mx-auto" style="color: #65665e;">
          Choose the work you need handled. We build the right accounting capacity around it.
        </p>
      </div>

      <!-- Carousel Wrapper -->
      <div class="relative reveal">

        <!-- Nav Arrows -->
        <button id="svc-prev" aria-label="Previous service" class="svc-arrow svc-arrow-up">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
        </button>
        <button id="svc-next" aria-label="Next service" class="svc-arrow svc-arrow-down">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>

        <!-- Track -->
        <div class="svc-track-outer">
          <div id="svc-track" class="svc-track">

            <!-- CARD 01 — BOOKKEEPING -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">01 / Bookkeeping</div>
                  <h3 class="svc-heading">Keep the books moving.</h3>
                  <p class="svc-sub">Accurate, up-to-date bookkeeping gives everything downstream a cleaner starting point.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Transaction recording</li>
                      <li><span class="svc-bullet">›</span>Bank reconciliations</li>
                      <li><span class="svc-bullet">›</span>Ledger maintenance</li>
                      <li><span class="svc-bullet">›</span>Bookkeeping support</li>
                      <li><span class="svc-bullet">›</span>Ongoing bookkeeping requirements</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">Your books stay current without your existing team having to carry every transaction internally.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 02 — PAYROLL -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">02 / Payroll</div>
                  <h3 class="svc-heading">Payroll handled properly, every pay cycle.</h3>
                  <p class="svc-sub">Keep payroll moving accurately and on schedule without adding another recurring responsibility to your internal team.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Payroll processing</li>
                      <li><span class="svc-bullet">›</span>Payroll administration</li>
                      <li><span class="svc-bullet">›</span>Recurring payroll requirements</li>
                      <li><span class="svc-bullet">›</span>Supporting payroll records</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">A recurring function gets handled consistently while your team stays focused on higher-value work.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 03 — MONTH-END -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">03 / Month-end</div>
                  <h3 class="svc-heading">Close the month without carrying it forward.</h3>
                  <p class="svc-sub">Month-end work shouldn't become a growing backlog for an already stretched team.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Month-end close</li>
                      <li><span class="svc-bullet">›</span>Reconciliations</li>
                      <li><span class="svc-bullet">›</span>Journal support</li>
                      <li><span class="svc-bullet">›</span>Period-end accounting</li>
                      <li><span class="svc-bullet">›</span>Supporting schedules</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">The month gets closed, the records stay current, and the next period starts from a clean position.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 04 — PAYABLES & RECEIVABLES -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">04 / Payables & Receivables</div>
                  <h3 class="svc-heading">Keep money moving in both directions.</h3>
                  <p class="svc-sub">The work behind paying suppliers and keeping receivables organised can become a significant operational load as the business grows.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Accounts payable</li>
                      <li><span class="svc-bullet">›</span>Accounts receivable</li>
                      <li><span class="svc-bullet">›</span>Invoice processing</li>
                      <li><span class="svc-bullet">›</span>Supplier records</li>
                      <li><span class="svc-bullet">›</span>Customer account support</li>
                      <li><span class="svc-bullet">›</span>Reconciliation support</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">Routine financial operations keep moving without requiring your internal team to carry the entire workload.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 05 — MANAGEMENT REPORTING -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">05 / Management Reporting</div>
                  <h3 class="svc-heading">Turn completed accounts into useful information.</h3>
                  <p class="svc-sub">Management reporting gives the business a clearer view of what has happened, and gives the people responsible for decisions the information they need.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Management accounts</li>
                      <li><span class="svc-bullet">›</span>Reporting packs</li>
                      <li><span class="svc-bullet">›</span>Supporting schedules</li>
                      <li><span class="svc-bullet">›</span>Regular reporting requirements</li>
                      <li><span class="svc-bullet">›</span>Financial information preparation</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">Your reporting is prepared consistently, so the people using it can spend their time interpreting the numbers rather than preparing them.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 06 — YEAR-END & TAX SUPPORT -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">06 / Year-end & Tax Support</div>
                  <h3 class="svc-heading">Get year-end work off the backlog.</h3>
                  <p class="svc-sub">Year-end brings another layer of accounting work. We provide the capacity to keep that work moving alongside your regular accounting requirements.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Year-end accounting support</li>
                      <li><span class="svc-bullet">›</span>Accounts preparation support</li>
                      <li><span class="svc-bullet">›</span>Supporting schedules</li>
                      <li><span class="svc-bullet">›</span>Tax-related accounting support</li>
                      <li><span class="svc-bullet">›</span>Information preparation</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">Your year-end workload has additional capacity behind it when your existing team needs it most.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 07 — AUDIT SUPPORT -->
            <div class="svc-card">
              <div class="svc-card-inner">
                <div class="svc-card-left">
                  <div class="svc-num">07 / Audit Support</div>
                  <h3 class="svc-heading">Be ready when the audit work begins.</h3>
                  <p class="svc-sub">Audit preparation can pull significant time from an already busy accounting team. We provide the additional capacity needed to keep the underlying work organised and moving.</p>
                </div>
                <div class="svc-card-right">
                  <div class="svc-col">
                    <p class="svc-col-label">We can handle</p>
                    <ul class="svc-list">
                      <li><span class="svc-bullet">›</span>Audit preparation support</li>
                      <li><span class="svc-bullet">›</span>Supporting schedules</li>
                      <li><span class="svc-bullet">›</span>Documentation</li>
                      <li><span class="svc-bullet">›</span>Reconciliations</li>
                      <li><span class="svc-bullet">›</span>Information gathering and preparation</li>
                    </ul>
                  </div>
                  <div class="svc-col">
                    <p class="svc-col-label">The result</p>
                    <p class="svc-result">Your team spends less time assembling the underlying accounting work and more time dealing with what actually requires their attention.</p>
                    <div class="svc-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 11 2 2 4-4"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div><!-- /svc-track -->
        </div><!-- /svc-track-outer -->

        <!-- Dot Indicators -->
        <div id="svc-dots" class="svc-dots">
          <button class="svc-dot svc-dot-active" data-index="0" aria-label="Service 1"></button>
          <button class="svc-dot" data-index="1" aria-label="Service 2"></button>
          <button class="svc-dot" data-index="2" aria-label="Service 3"></button>
          <button class="svc-dot" data-index="3" aria-label="Service 4"></button>
          <button class="svc-dot" data-index="4" aria-label="Service 5"></button>
          <button class="svc-dot" data-index="5" aria-label="Service 6"></button>
          <button class="svc-dot" data-index="6" aria-label="Service 7"></button>
        </div>

      </div><!-- /relative -->
    </div><!-- /shell -->
  </section>


  <!-- ================================================================
       SECTION 10 — NOT A PACKAGE
  ================================================================ -->
  <section class="bg-background py-24 lg:py-36 border-b border-hairline">
    <div class="shell">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-center">

        <!-- Left -->
        <div class="lg:col-span-5 reveal">
          <div class="about-eyebrow-light mb-6">Built around the work</div>
          <h2 class="font-display font-light leading-[1.1] mb-6" style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;">
            You don't have to hand over everything.
          </h2>
          <p class="text-[1rem] leading-relaxed mb-6" style="color: #65665e;">
            Some businesses need day-to-day accounting handled. Others need additional capacity around month-end, year-end or a particular part of the function.
          </p>
          <p class="text-[1rem] leading-relaxed" style="color: #65665e;">
            Calveris can work around the requirement rather than forcing every business into the same package.
          </p>
          <div class="mt-10 pt-8 text-[0.9rem] leading-relaxed text-muted-foreground border-t border-hairline">
            A single requirement. A defined workstream. Or additional accounting capacity across the function.
          </div>
        </div>

        <!-- Right: Visual flow -->
        <div class="lg:col-span-7 reveal">
          <div class="flex flex-col items-center gap-0 max-w-sm mx-auto lg:mx-0">
            <!-- Flow Step -->
            <div class="w-full clay-flow-card rounded-[2rem] p-6 flex items-center gap-5">
              <div class="w-10 h-10 rounded-full clay-flow-dot flex items-center justify-center shrink-0">
                <div class="w-2 h-2 rounded-full bg-accent"></div>
              </div>
              <span class="font-display text-[1.1rem] font-light text-foreground">One function</span>
            </div>
            <div class="flex flex-col items-center py-3 text-accent text-lg opacity-60">↓</div>
            <div class="w-full clay-flow-card rounded-[2rem] p-6 flex items-center gap-5">
              <div class="w-10 h-10 rounded-full clay-flow-dot flex items-center justify-center shrink-0">
                <div class="w-2 h-2 rounded-full bg-accent"></div>
              </div>
              <span class="font-display text-[1.1rem] font-light text-foreground">Several workstreams</span>
            </div>
            <div class="flex flex-col items-center py-3 text-accent text-lg opacity-60">↓</div>
            <div class="w-full clay-flow-card-accent rounded-[2rem] p-6 flex items-center gap-5">
              <div class="w-10 h-10 rounded-full clay-flow-dot-accent flex items-center justify-center shrink-0">
                <div class="w-2 h-2 rounded-full bg-accent"></div>
              </div>
              <span class="font-display text-[1.1rem] font-light text-foreground">Choose what needs capacity</span>
            </div>
            <div class="flex flex-col items-center py-3 text-accent text-lg opacity-60">↓</div>
            <div class="w-full rounded-[2rem] p-6 flex items-center gap-5" style="background: #0d1b16;">
              <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: rgba(126,200,160,0.1); box-shadow: inset 4px 4px 8px rgba(0,0,0,0.3), inset -2px -2px 5px rgba(255,255,255,0.05);">
                <div class="w-2 h-2 rounded-full bg-accent" style="box-shadow: 0 0 8px rgba(126,200,160,0.8);"></div>
              </div>
              <span class="font-display text-[1.1rem] font-light" style="color: #f0f5f0;">Calveris handles it</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================
       SECTION 11 — WHO WE WORK WITH
  ================================================================ -->
  <section class="bg-background py-24 lg:py-36 border-b border-hairline">
    <div class="shell">
      <div class="reveal mb-16">
        <div class="about-eyebrow-light mb-6">Two ways to work with Calveris</div>
        <h2 class="font-display font-light leading-[1.1]" style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;">
          Who we work with.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal">

        <!-- Card: Growing businesses -->
        <div class="who-card rounded-[2.5rem] p-10 lg:p-12 flex flex-col gap-8">
          <div>
            <div class="text-[10px] tracking-[0.18em] uppercase font-bold text-accent mb-4">Growing businesses</div>
            <h3 class="font-display text-[1.6rem] font-light leading-[1.2] text-foreground mb-4">
              Add accounting capacity without building the entire function internally.
            </h3>
          </div>
          <div class="mt-auto pt-6 border-t border-hairline">
            <a href="/contact" class="group inline-flex items-center text-[11px] tracking-[0.18em] font-bold uppercase text-foreground hover:text-forest transition-colors duration-300">
              See how it works for businesses
              <span class="ml-3 transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>

        <!-- Card: Finance & accounting firms -->
        <div class="who-card rounded-[2.5rem] p-10 lg:p-12 flex flex-col gap-8">
          <div>
            <div class="text-[10px] tracking-[0.18em] uppercase font-bold text-accent mb-4">Finance & accounting firms</div>
            <h3 class="font-display text-[1.6rem] font-light leading-[1.2] text-foreground mb-4">
              Extend your accounting delivery capacity while keeping the client relationship.
            </h3>
          </div>
          <div class="mt-auto pt-6 border-t border-hairline">
            <a href="/firms" class="group inline-flex items-center text-[11px] tracking-[0.18em] font-bold uppercase text-foreground hover:text-forest transition-colors duration-300">
              See how it works for firms
              <span class="ml-3 transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================
       SECTION 12 — WORKFLOW
  ================================================================ -->
  <section class="bg-background py-24 lg:py-36 border-b border-hairline overflow-hidden">
    <div class="shell">
      <div class="reveal mb-16">
        <div class="about-eyebrow-light mb-6">The Workflow</div>
        <h2 class="font-display font-light leading-[1.1] mb-6" style="font-size: clamp(2rem, 4vw, 3rem); color: #0d1b16;">
          From requirement to completed accounting work.
        </h2>
      </div>

      <!-- Workflow Steps -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 reveal">

        <div class="workflow-step rounded-[2rem] p-8">
          <div class="text-[10px] tracking-[0.18em] uppercase font-bold text-accent mb-6">01</div>
          <h3 class="font-display text-[1.3rem] font-light text-foreground mb-4 leading-snug">Your Requirement</h3>
          <p class="text-[0.9rem] leading-relaxed text-muted-foreground">What needs to be handled?</p>
          <div class="mt-8 text-accent text-2xl opacity-40 hidden lg:block">↓</div>
        </div>

        <div class="workflow-step rounded-[2rem] p-8">
          <div class="text-[10px] tracking-[0.18em] uppercase font-bold text-accent mb-6">02</div>

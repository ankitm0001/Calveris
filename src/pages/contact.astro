---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import ContactBuilder from "../components/ContactBuilder";
---

<Layout>
  <Navbar client:load />
  
  <header class="contact-hero relative overflow-hidden flex flex-col" id="top">

    <main class="flex flex-col justify-center shell relative z-10 pt-[120px] pb-10">
      <div class="w-full h-px mb-10" style="background: rgba(126,200,160,0.15);"></div>

      <div class="flex flex-col justify-center relative z-20">

        <!-- Eyebrow pill -->
        <div class="inline-flex w-fit items-center gap-2 px-6 py-2.5 rounded-full text-[9px] tracking-widest uppercase font-bold mb-8 contact-eyebrow opacity-0 animate-fade-in" style="animation-delay: 0.2s;">
          <span aria-hidden="true" class="inline-block size-[6px] rounded-full" style="background:#7ec8a0;"></span>
          Contact
        </div>

        <h1 class="font-display text-5xl md:text-6xl lg:text-[4.5rem] leading-[1.15] mb-6 max-w-4xl font-light" style="color: #f0f5f0;">
          <span class="opacity-0 animate-fade-in" style="animation-delay: 0.4s;">Let's build the</span>
          <br>
          <span class="reveal-mask">
            <span class="italic opacity-0 animate-reveal-up" style="animation-delay: 0.5s; color: #7ec8a0;">right support</span>
          </span>
          <br>
          <span class="opacity-0 animate-fade-in" style="animation-delay: 0.8s;">for your business.</span>
        </h1>

        <p class="max-w-xl text-[1.05rem] leading-relaxed font-light opacity-0 animate-fade-in" style="animation-delay: 1.0s; color: rgba(240,245,240,0.6);">
          Tell us what you need support with. Select what applies, add anything we should know, and we'll take it from there.
        </p>
      </div>
    </main>
  </header>

  <ContactBuilder client:load />

  <Footer />
</Layout>

<script>
  function initHero() {
    setTimeout(() => {
      const texts = document.querySelectorAll('.text-emphasis');
      texts.forEach((text, i) => {
        setTimeout(() => text.classList.add('animate-underline'), i * 250);
      });
    }, 100);
  }
  
  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
.contact-hero {
  background: #0d1b16;
}

.contact-eyebrow {
  color: #7ec8a0;
  background: #0d1b16;
  box-shadow: inset 4px 4px 8px #040907, inset -4px -4px 8px #183329;
}

.reveal-mask {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes revealUp { 0% { transform: translateY(100%); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
@keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }

.animate-reveal-up {
  animation: revealUp 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
}
.animate-fade-in {
  animation: fadeIn 1.5s ease-out forwards;
}
</style>

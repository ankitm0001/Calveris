---
---

<section id="scale" class="bg-[#0d1b16] text-white py-28 lg:py-40 scroll-mt-[90px] border-b border-hairline-light">
  
  <div class="shell relative z-10">
    
    <div class="reveal mb-16 lg:mb-24 text-center flex flex-col items-center">
      <!-- Neumorphic Pressed Pill Badge -->
      <div class="flex items-center gap-2 bg-[#0d1b16] text-[#a3c2a3] px-6 py-2.5 rounded-full text-[9px] tracking-widest uppercase font-bold mb-8 dark-clay-pressed">
        A Track Record Of Delivery
      </div>
      <h2 class="display-lg max-w-4xl text-balance text-white">
        Capacity built through real work.
      </h2>
      <p class="text-[17px] text-[#d1d5db] leading-relaxed mt-6 max-w-2xl text-balance font-light">
        The work has grown. So has the team behind it.
      </p>
    </div>

    <!-- METRICS GRID -->
    <div class="reveal">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-8">
        
        <!-- Metric 01: EXPERIENCE -->
        <div class="relative group flex flex-col items-center text-center p-8 lg:p-10 rounded-[2rem] bg-[#0d1b16] dark-clay-card hover:-translate-y-2 transition-transform duration-500 cursor-default">
          <div class="font-display text-5xl xl:text-6xl mb-4 text-white group-hover:text-[#a3c2a3] transition-colors duration-500">
            5+
          </div>
          <div class="text-[11px] xl:text-[12px] text-[#9ca3af] uppercase tracking-[0.1em] font-semibold">
            Years delivering
          </div>
        </div>

        <!-- Metric 02: BREADTH -->
        <div class="relative group flex flex-col items-center text-center p-8 lg:p-10 rounded-[2rem] bg-[#0d1b16] dark-clay-card hover:-translate-y-2 transition-transform duration-500 cursor-default">
          <div class="font-display text-5xl xl:text-6xl mb-4 text-white group-hover:text-[#a3c2a3] transition-colors duration-500">
            500+
          </div>
          <div class="text-[11px] xl:text-[12px] text-[#9ca3af] uppercase tracking-[0.1em] font-semibold">
            Businesses supported
          </div>
        </div>

        <!-- Metric 03: VOLUME -->
        <div class="relative group flex flex-col items-center text-center p-8 lg:p-10 rounded-[2rem] bg-[#0d1b16] dark-clay-card hover:-translate-y-2 transition-transform duration-500 cursor-default">
          <div class="font-display text-5xl xl:text-6xl mb-4 text-white group-hover:text-[#a3c2a3] transition-colors duration-500">
            400k+
          </div>
          <div class="text-[11px] xl:text-[12px] text-[#9ca3af] uppercase tracking-[0.1em] font-semibold">
            Work completed
          </div>
        </div>

        <!-- Metric 04: CAPACITY -->
        <div class="relative group flex flex-col items-center text-center p-8 lg:p-10 rounded-[2rem] bg-[#0d1b16] dark-clay-card hover:-translate-y-2 transition-transform duration-500 cursor-default">
          <div class="font-display text-5xl xl:text-6xl mb-4 text-white group-hover:text-[#a3c2a3] transition-colors duration-500">
            30+
          </div>
          <div class="text-[11px] xl:text-[12px] text-[#9ca3af] uppercase tracking-[0.1em] font-semibold">
            ACCA accountants
          </div>
        </div>

        <!-- Metric 05: QUALITY -->
        <div class="relative group flex flex-col items-center text-center p-8 lg:p-10 rounded-[2rem] bg-[#0d1b16] dark-clay-card hover:-translate-y-2 transition-transform duration-500 cursor-default">
          <div class="font-display text-5xl xl:text-6xl mb-4 text-white group-hover:text-[#a3c2a3] transition-colors duration-500">
            98%
          </div>
          <div class="text-[11px] xl:text-[12px] text-[#9ca3af] uppercase tracking-[0.1em] font-semibold">
            On-time delivery
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* Dark Neumorphism: Base is #0d1b16. Shadows must be darker/lighter to be visible */
  .dark-clay-card {
    box-shadow: 18px 18px 36px #040907, -18px -18px 36px #183329;
  }

  .dark-clay-pressed {
    box-shadow: inset 6px 6px 12px #040907, inset -6px -6px 12px #183329;
  }
</style>

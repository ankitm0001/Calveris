---

<section id="scale" class="bg-forest text-forest-foreground py-28 lg:py-40 scroll-mt-[90px] border-b border-hairline-light">
  <div class="shell">
    
    <div class="reveal mb-16 lg:mb-24">
      <div class="flex items-center gap-3 text-[11px] tracking-[0.18em] text-accent font-semibold mb-6 uppercase">
        <span aria-hidden="true" class="inline-block size-[6px] rotate-45 bg-accent"></span>
        A TRACK RECORD OF DELIVERY
      </div>
      <h2 class="display-lg max-w-4xl text-balance">
        Capacity built through real work.
      </h2>
      <p class="text-[17px] text-forest-foreground/60 leading-relaxed mt-6">
        The work has grown. So has the team behind it.
      </p>
    </div>

    <!-- METRICS GRID -->
    <div class="reveal">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-y-16 lg:gap-y-0 gap-x-8 lg:gap-x-10">
        
        <!-- Metric 01: EXPERIENCE -->
        <div class="relative group flex flex-col pt-8 lg:pt-0 border-t border-hairline-light lg:border-none">
          <div class="font-display text-5xl xl:text-6xl mb-6 text-forest-foreground group-hover:text-accent transition-colors duration-500">
            [X]+
          </div>
          
          <div class="text-[12px] xl:text-[13px] text-forest-foreground/60 uppercase tracking-[0.1em] leading-relaxed">
            Years delivering accounting
          </div>
        </div>

        <!-- Metric 02: BREADTH -->
        <div class="relative group flex flex-col pt-8 lg:pt-0 border-t border-hairline-light lg:border-none">
          <div class="font-display text-5xl xl:text-6xl mb-6 text-forest-foreground group-hover:text-accent transition-colors duration-500">
            [X]+
          </div>
          
          <div class="text-[12px] xl:text-[13px] text-forest-foreground/60 uppercase tracking-[0.1em] leading-relaxed">
            Businesses supported
          </div>
        </div>

        <!-- Metric 03: VOLUME -->
        <div class="relative group flex flex-col pt-8 lg:pt-0 border-t border-hairline-light lg:border-none">
          <div class="font-display text-5xl xl:text-6xl mb-6 text-forest-foreground group-hover:text-accent transition-colors duration-500">
            [X]+
          </div>
          
          <div class="text-[12px] xl:text-[13px] text-forest-foreground/60 uppercase tracking-[0.1em] leading-relaxed">
            Accounting work completed
          </div>
        </div>

        <!-- Metric 04: CAPACITY -->
        <div class="relative group flex flex-col pt-8 lg:pt-0 border-t border-hairline-light lg:border-none">
          <div class="font-display text-5xl xl:text-6xl mb-6 text-forest-foreground group-hover:text-accent transition-colors duration-500">
            [X]+
          </div>
          
          <div class="text-[12px] xl:text-[13px] text-forest-foreground/60 uppercase tracking-[0.1em] leading-relaxed">
            ACCA-qualified accountants
          </div>
        </div>

        <!-- Metric 05: QUALITY -->
        <div class="relative group flex flex-col pt-8 lg:pt-0 border-t border-hairline-light lg:border-none">
          <div class="font-display text-5xl xl:text-6xl mb-6 text-forest-foreground group-hover:text-accent transition-colors duration-500">
            [X]%
          </div>
          
          <div class="text-[12px] xl:text-[13px] text-forest-foreground/60 uppercase tracking-[0.1em] leading-relaxed">
            On-time delivery
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

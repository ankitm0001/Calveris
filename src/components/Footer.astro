        <li><a href="#founders" class="text-sm text-ink-foreground/75 transition-colors hover:text-accent">About us</a></li>
        <li><a href="#faq" class="text-sm text-ink-foreground/75 transition-colors hover:text-accent">FAQ</a></li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <p class="eyebrow text-ink-foreground/45">Services</p>
      <ul class="mt-6 space-y-3">
        <li><a href="#roles" class="text-sm text-ink-foreground/75 transition-colors hover:text-accent">Bookkeeping</a></li>
        <li><a href="#roles" class="text-sm text-ink-foreground/75 transition-colors hover:text-accent">Payroll</a></li>
        <li><a href="#roles" class="text-sm text-ink-foreground/75 transition-colors hover:text-accent">Reporting</a></li>
        <li><a href="#roles" class="text-sm text-ink-foreground/75 transition-colors hover:text-accent">Year-end</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <p class="eyebrow text-ink-foreground/45">Enquiries</p>
      <ul class="mt-6 space-y-3 text-sm text-ink-foreground/75">
        <li>
          <a href="mailto:info@calveris.co.uk" class="transition-colors hover:text-accent">info@calveris.co.uk</a>
        </li>
        <li>
          <a href="tel:+447999901081" class="transition-colors hover:text-accent">+44 7999 901081</a>
        </li>
        <li>
          <a href="https://wa.me/447999901081" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">WhatsApp a founder ↗</a>
        </li>
        <li>Ahmedabad · Global</li>
        <li>Founder-level access, always.</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-hairline-light">
    <div class="shell flex flex-wrap items-center justify-between gap-4 py-8 text-xs text-ink-foreground/45">
      <p>© {currentYear} Calveris Global. All rights reserved.</p>
      <p class="eyebrow text-ink-foreground/40">For global businesses</p>

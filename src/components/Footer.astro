---
const currentYear = new Date().getFullYear();
---

<footer class="footer-dark-section text-forest-foreground">
  <!-- Subtle top groove -->
  <div
    class="h-1 w-full"
    style="box-shadow: inset 0 2px 4px #040907, inset 0 -1px 1px #183329;"
  >
  </div>

  <div class="shell grid gap-14 py-20 lg:grid-cols-12 lg:py-28">
    <div class="lg:col-span-5">
      <a href="/" class="inline-block mb-0">
        <img
          src="/images/logo-og.png"
          alt="Calveris Global"
          style="height: 48px; width: auto; opacity: 0.95;"
          class="filter invert hue-rotate-180 brightness-200 contrast-125"
        />
      </a>
      <p
        class="mt-4 max-w-sm font-display text-2xl font-light italic"
        style="color: rgba(240,245,240,0.8);"
      >
        Your finance function.<br />More capacity. Less complexity.
      </p>
      <p
        class="mt-6 max-w-sm text-sm leading-relaxed"
        style="color: rgba(240,245,240,0.55);"
      >
        Calveris Global provides dedicated accounting and finance professionals
        to businesses worldwide. Your control. Our people.
      </p>
    </div>

    <div class="lg:col-span-2">
      <div
        class="inline-block px-4 py-1.5 rounded-full text-[8px] uppercase tracking-widest font-bold mb-6 footer-pill"
      >
        Navigation
      </div>
      <ul class="space-y-4">
        <li>
          <a
            href="#model"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">How we work</a>
        </li>
        <li>
          <a
            href="#roles"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">Services</a>
        </li>
        <li>
          <a
            href="#trust"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">Trust</a>
        </li>
        <li>
          <a
            href="#founders"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">About us</a>
        </li>
        <li>
          <a
            href="/about"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">About Calveris</a>
        </li>
        <li>
          <a
            href="#faq"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">FAQ</a>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <div
        class="inline-block px-4 py-1.5 rounded-full text-[8px] uppercase tracking-widest font-bold mb-6 footer-pill"
      >
        Services
      </div>
      <ul class="space-y-4">
        <li>
          <a
            href="#roles"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">Bookkeeping</a>
        </li>
        <li>
          <a
            href="#roles"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">Payroll</a>
        </li>
        <li>
          <a
            href="#roles"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">Reporting</a>
        </li>
        <li>
          <a
            href="#roles"
            class="text-sm transition-colors hover:text-[#7ec8a0]"
            style="color: rgba(240,245,240,0.75);">Year-end</a>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <div
        class="inline-block px-4 py-1.5 rounded-full text-[8px] uppercase tracking-widest font-bold mb-6 footer-pill"
      >
        Enquiries
      </div>
      <ul class="space-y-4 text-sm" style="color: rgba(240,245,240,0.75);">
        <li>
          <a
            href="mailto:info@calveris.co.uk"
            class="transition-colors hover:text-[#7ec8a0]"
            >info@calveris.co.uk</a
          >
        </li>
        <li>
          <a
            href="tel:+447999901081"
            class="transition-colors hover:text-[#7ec8a0]">+44 7999 901081</a
          >
        </li>
        <li>
          <a
            href="https://wa.me/447999901081"
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-[#7ec8a0]"
            >WhatsApp a founder ↗</a
          >
        </li>
        <li class="pt-2 text-[12px] opacity-70">Ahmedabad · Global</li>
        <li class="text-[12px] opacity-70">Founder-level access, always.</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[#183329]/50">
    <div
      class="shell flex flex-wrap items-center justify-between gap-4 py-8 text-xs"
      style="color: rgba(240,245,240,0.45);"
    >
      <p>© {currentYear} Calveris Global. All rights reserved.</p>
      <div
        class="inline-block px-4 py-1.5 rounded-full text-[8px] uppercase tracking-widest font-bold footer-pill opacity-70"
      >
        For global businesses
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-dark-section {
    background: #0d1b16;
  }

  .footer-pill {
    color: #7ec8a0;
    background: #0d1b16;
    box-shadow:
      inset 3px 3px 6px #040907,
      inset -3px -3px 6px #183329;
  }
</style>

---
---

<section id="controls" class="bg-background py-28 lg:py-40 scroll-mt-[90px] border-b border-hairline overflow-hidden">
  <div class="shell grid gap-16 lg:gap-20 lg:grid-cols-2 items-start">
      
      <!-- LEFT COLUMN -->
      <div class="pr-0 lg:pr-8 relative reveal">
        <div class="flex items-center gap-3 text-[11px] tracking-[0.18em] text-accent font-semibold mb-8 uppercase lg:-mt-[52px]">
          <span aria-hidden="true" class="inline-block size-[6px] rotate-45 bg-accent"></span>
          Quality & Control
        </div>
        <h2 class="display-lg mb-8 max-w-md text-balance text-foreground">
          Quality isn't left to the final check.
        </h2>
        <p class="text-[17px] text-muted-foreground leading-relaxed max-w-md">
          It is built into the people, processes and controls behind every piece of work we deliver.
        </p>

        <!-- VERTICAL REVIEW FLOW -->
        <div class="mt-16 lg:mt-20 hidden lg:flex flex-col items-center text-center w-full max-w-md">
          
          <!-- Stage 01 -->
          <div class="text-[11px] lg:text-[12px] uppercase tracking-[0.1em] font-medium text-muted-foreground">
            Accounting work received
          </div>
          
          <div class="py-4">
            <span class="text-muted-foreground/50 text-[16px]">↓</span>
          </div>

          <!-- Stage 02 -->
          <div class="text-[11px] lg:text-[12px] uppercase tracking-[0.1em] font-medium text-muted-foreground">
            Accounting work completed
          </div>
          
          <div class="py-4">
            <span class="text-muted-foreground/50 text-[16px]">↓</span>
          </div>

          <!-- Stage 03 -->
          <div class="text-[11px] lg:text-[12px] uppercase tracking-[0.1em] font-semibold text-accent">
            Senior team review
          </div>
          
          <div class="py-4">
            <span class="text-accent/50 text-[16px]">↓</span>
          </div>

          <!-- Stage 04 -->
          <div class="text-[11px] lg:text-[12px] uppercase tracking-[0.1em] font-medium text-muted-foreground">
            Issues identified and corrected
          </div>
          
          <div class="py-4">
            <span class="text-muted-foreground/50 text-[16px]">↓</span>
          </div>

          <!-- Stage 05 -->
          <div class="text-[11px] lg:text-[12px] uppercase tracking-[0.1em] font-semibold text-accent">
            Work reviewed and approved
          </div>
          
          <div class="py-4">
            <span class="text-accent/50 text-[16px]">↓</span>
          </div>

          <!-- Stage 06 -->
          <div class="text-[11px] lg:text-[12px] uppercase tracking-[0.1em] font-medium text-muted-foreground">
            Delivered to you or your client
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: VERTICAL STACK -->
      <div class="relative reveal">
        
        <!-- Subtle vertical connecting line -->
        <div class="absolute top-8 bottom-12 left-[19px] w-[1px] bg-hairline-light hidden sm:block"></div>

        <div class="flex flex-col gap-14 sm:gap-20 relative z-10">
          
          <!-- CONTROL 01 -->
          <div class="relative flex gap-6 sm:gap-10 group">
            <div class="hidden sm:flex flex-col items-center pt-1">
              <div class="size-[38px] rounded-full border border-hairline bg-background flex items-center justify-center text-[10px] font-mono text-muted-foreground group-hover:text-accent group-hover:border-accent transition-colors duration-500">
                01
              </div>
            </div>
            <div class="flex-1 pt-1 sm:pt-0">
              <span class="sm:hidden text-[10px] text-accent font-mono tracking-widest mb-3 block">01</span>
              <h3 class="text-[20px] sm:text-[22px] lg:text-[24px] font-display mb-4 text-foreground">ACCA-qualified accountants</h3>
              <p class="text-[15px] text-muted-foreground leading-relaxed max-w-lg">
                All accountants on the delivery team are ACCA certified.
              </p>
            </div>
          </div>

          <!-- CONTROL 02 (Slightly more emphasis) -->
          <div class="relative flex gap-6 sm:gap-10 group">
            <div class="hidden sm:flex flex-col items-center pt-1">
              <div class="size-[38px] rounded-full border border-accent/50 bg-accent/5 flex items-center justify-center text-[10px] font-mono text-accent transition-colors duration-500">
                02
              </div>
            </div>
            <div class="flex-1 pt-1 sm:pt-0 border-l-2 sm:border-l-0 border-accent pl-5 sm:pl-0 ml-[-5px] sm:ml-0">
              <span class="sm:hidden text-[10px] text-accent font-mono tracking-widest mb-3 block">02</span>
              <h3 class="text-[22px] sm:text-[25px] lg:text-[28px] font-display mb-4 text-foreground tracking-tight">Every piece is reviewed.</h3>
              <p class="text-[16px] text-foreground/90 leading-relaxed max-w-lg font-medium">
                Work is reviewed by senior team members before it reaches you or your clients.
              </p>
            </div>
          </div>

          <!-- CONTROL 03 -->
          <div class="relative flex gap-6 sm:gap-10 group">
            <div class="hidden sm:flex flex-col items-center pt-1">
              <div class="size-[38px] rounded-full border border-hairline bg-background flex items-center justify-center text-[10px] font-mono text-muted-foreground group-hover:text-accent group-hover:border-accent transition-colors duration-500">
                03
              </div>
            </div>
            <div class="flex-1 pt-1 sm:pt-0">
              <span class="sm:hidden text-[10px] text-accent font-mono tracking-widest mb-3 block">03</span>
              <h3 class="text-[20px] sm:text-[22px] lg:text-[24px] font-display mb-4 text-foreground">Controlled access & working environment</h3>
              <p class="text-[15px] text-muted-foreground leading-relaxed max-w-lg">
                Sensitive client information is handled within defined data-protection controls and a controlled working environment, including a strict no-phone policy at workstations.
              </p>
            </div>
          </div>

          <!-- CONTROL 04 -->
          <div class="relative flex gap-6 sm:gap-10 group">
            <div class="hidden sm:flex flex-col items-center pt-1">
              <div class="size-[38px] rounded-full border border-hairline bg-background flex items-center justify-center text-[10px] font-mono text-muted-foreground group-hover:text-accent group-hover:border-accent transition-colors duration-500">
                04
              </div>
            </div>
            <div class="flex-1 pt-1 sm:pt-0">
              <span class="sm:hidden text-[10px] text-accent font-mono tracking-widest mb-3 block">04</span>
              <h3 class="text-[20px] sm:text-[22px] lg:text-[24px] font-display mb-4 text-foreground">GDPR certified</h3>
              <p class="text-[15px] text-muted-foreground leading-relaxed max-w-lg">
                Our operations are GDPR certified, supporting the way sensitive client and financial information is handled.
              </p>
            </div>
          </div>

          <!-- CONTROL 05 -->
          <div class="relative flex gap-6 sm:gap-10 group">
            <div class="hidden sm:flex flex-col items-center pt-1">
              <div class="size-[38px] rounded-full border border-hairline bg-background flex items-center justify-center text-[10px] font-mono text-muted-foreground group-hover:text-accent group-hover:border-accent transition-colors duration-500">
                05
              </div>
            </div>
            <div class="flex-1 pt-1 sm:pt-0">
              <span class="sm:hidden text-[10px] text-accent font-mono tracking-widest mb-3 block">05</span>
              <h3 class="text-[20px] sm:text-[22px] lg:text-[24px] font-display mb-4 text-foreground">Working when your business works</h3>
              <p class="text-[15px] text-muted-foreground leading-relaxed max-w-lg">
                Our delivery team works to both UK and US business hours, so communication and accounting work stay within your working day.
              </p>
            </div>
          </div>

        </div>
      </div>
      
    </div>
</section>

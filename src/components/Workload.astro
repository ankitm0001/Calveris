---
---
<section id="workload" class="workload-section py-24 lg:py-32 border-b border-hairline">
  <div class="shell">
    <h2 class="display-lg max-w-[20ch] mb-20 text-balance leading-[1.1]">
      Your finance workload has <em class="not-italic text-accent italic font-light">outgrown</em> your team.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 pt-12">
      <!-- Col 1 -->
      <div class="workload-col group relative p-8 lg:p-10 rounded-[2rem] clay-card hover:clay-card-hover transition-all duration-500 cursor-default">
        <div class="indicator-line absolute top-[-1px] left-[-1px] right-[-1px] h-[2px] bg-accent transform scale-x-0 transition-transform origin-left duration-500 z-10"></div>
        <div class="eyebrow text-muted-foreground mb-4 transition-colors group-hover:text-foreground">01 / THE CATALYST</div>
        <h3 class="text-xl font-medium text-foreground mb-3">Business Grows</h3>
        <p class="text-[0.95rem] text-muted-foreground leading-relaxed">As the business expands, so does the financial work behind it.</p>
        
        <!-- Flow Arrow (Right on Desktop, Down on Mobile) -->
        <div class="hidden md:block absolute top-1/2 -translate-y-1/2 -right-6 lg:-right-8 translate-x-1/2 text-muted-foreground/30">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="md:hidden absolute -bottom-6 translate-y-1/2 left-1/2 -translate-x-1/2 text-muted-foreground/30">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>

      <!-- Col 2 -->
      <div class="workload-col group relative p-8 lg:p-10 rounded-[2rem] clay-card hover:clay-card-hover transition-all duration-500 cursor-default">
        <div class="indicator-line absolute top-[-1px] left-[-1px] right-[-1px] h-[2px] bg-accent transform scale-x-0 transition-transform origin-left duration-500 z-10"></div>
        <div class="eyebrow text-muted-foreground mb-4 transition-colors group-hover:text-foreground">02 / THE REALITY</div>
        <h3 class="text-xl font-medium text-foreground mb-3">Workload Builds</h3>
        <p class="text-[0.95rem] text-muted-foreground leading-relaxed">More transactions, tighter month-ends and heavier reporting put more pressure on the team.</p>

        <!-- Flow Arrow (Right on Desktop, Down on Mobile) -->
        <div class="hidden md:block absolute top-1/2 -translate-y-1/2 -right-6 lg:-right-8 translate-x-1/2 text-muted-foreground/30">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="md:hidden absolute -bottom-6 translate-y-1/2 left-1/2 -translate-x-1/2 text-muted-foreground/30">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>

      <!-- Col 3 -->
      <div class="workload-col group relative p-8 lg:p-10 rounded-[2rem] clay-card hover:clay-card-hover transition-all duration-500 cursor-default">
        <div class="indicator-line absolute top-[-1px] left-[-1px] right-[-1px] h-[2px] bg-accent transform scale-x-0 transition-transform origin-left duration-500 z-10"></div>
        <div class="eyebrow text-accent mb-4 transition-colors">03 / THE FRICTION</div>
        <h3 class="text-xl font-medium text-foreground mb-3">Capacity Gets Tight</h3>
        <p class="text-[0.95rem] text-muted-foreground leading-relaxed">The team may stay the same while the workload keeps growing — making speed, attention and quality harder to protect.</p>
      </div>
    </div>

    <!-- The Box below -->
    <div class="mt-24 lg:mt-32 rounded-[2rem] clay-card p-8 lg:p-16 relative overflow-hidden">
      <!-- Ambient background inside -->
      <div class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-l from-white via-white to-transparent pointer-events-none opacity-60"></div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 relative z-10 items-center">
        <div>
          <h3 class="display-md mb-8">
            More capacity would help.<br/>
            <span class="text-muted-foreground italic font-light">But at what cost?</span>
          </h3>
          <p class="text-base text-foreground/80 leading-relaxed mb-10 max-w-md">
            Building internally commits money, people, and management attention to finance—resources that could otherwise fund growth.
          </p>
          <div class="border-l-[2px] border-accent pl-6 py-1">
            <p class="text-[1.05rem] text-foreground font-medium leading-relaxed">
              The question isn't simply whether more capacity is needed. It's where it should come from.
            </p>
          </div>
        </div>

        <div class="flex flex-col justify-center gap-6">
          <div class="group rounded-2xl clay-inset p-6 lg:p-8 flex items-center justify-between transition-all cursor-default">
            <div>
              <div class="eyebrow text-muted-foreground mb-2 group-hover:text-foreground transition-colors">BUILD INTERNALLY</div>
              <div class="text-[10px] tracking-[0.15em] uppercase text-muted-foreground/60">ABSORBS RESOURCES</div>
            </div>
            <div class="flex items-center gap-4 text-[0.85rem] font-medium text-muted-foreground/60 transition-colors group-hover:text-muted-foreground/80">
              <span class="line-through decoration-1">Sales - Product - Hiring</span>
              <span class="text-[#d05c5c] font-bold text-lg mb-0.5">↓</span>
            </div>
          </div>

          <div class="group rounded-2xl clay-card border border-accent/10 p-6 lg:p-8 flex items-center justify-between transition-all cursor-default">
            <div>
              <div class="eyebrow text-accent mb-2">ADD EXTERNALLY</div>
              <div class="text-[10px] tracking-[0.15em] uppercase text-accent/60">PRESERVES RESOURCES</div>
            </div>
            <div class="flex items-center gap-4 text-[0.85rem] font-medium text-foreground transition-colors">
              <span>Sales - Product - Hiring</span>
              <span class="text-accent font-bold text-lg mb-0.5">↑</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .workload-section {
    background-color: var(--color-background);
  }

  .clay-card {
    background: var(--color-background);
    box-shadow: 20px 20px 40px #c4c6cc, -20px -20px 40px #ffffff;
  }

  .clay-card:hover,
  .clay-card-hover {
    box-shadow: 25px 25px 50px #b8bac0, -25px -25px 50px #ffffff, inset 1px 1px 2px rgba(255, 255, 255, 0.8);
    transform: translateY(-4px);
  }

  .clay-inset {
    background: var(--color-background);
    box-shadow: inset 8px 8px 16px #c4c6cc, inset -8px -8px 16px #ffffff;
  }

  .workload-col.is-active .indicator-line {
    transform: scaleX(1);
  }
</style>

<script>
  function initWorkload() {
    const cols = document.querySelectorAll('.workload-col');
    cols.forEach((col, index) => {
      const activate = () => {
        cols.forEach((c, i) => {
          if (i <= index) c.classList.add('is-active');
          else c.classList.remove('is-active');
        });
      };
      const deactivate = () => {
        cols.forEach(c => c.classList.remove('is-active'));
      };
      
      col.addEventListener('mouseenter', activate);
      col.addEventListener('mouseleave', deactivate);
      col.addEventListener('click', activate);
    });
  }
  initWorkload();
  document.addEventListener('astro:page-load', initWorkload);
</script>

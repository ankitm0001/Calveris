---
---

<section id="relationships" class="bg-background text-foreground py-28 lg:py-40 scroll-mt-[90px]" style="border-bottom: 1px solid var(--color-hairline)">
  <div class="shell">
    
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-20 lg:mb-28 reveal">
      <h2 class="display-lg mb-8 text-balance">
        Two ways to put our accounting capacity to work.
      </h2>
      <p class="text-lg lg:text-xl text-muted-foreground text-balance">
        We work directly with growing businesses, or behind finance and accounting firms as an extension of their accounting delivery team.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 relative">
      
      <!-- CARD A: DIRECT BUSINESS -->
      <div class="reveal flex flex-col rounded-[2.5rem] bg-background p-10 lg:p-14 clay-card border border-white/50 hover:-translate-y-2 transition-transform duration-500 cursor-default">
        
        <div class="flex justify-between items-center mb-10">
          <div class="flex items-center gap-2 bg-background clay-pressed px-5 py-2 rounded-full text-[9px] tracking-widest uppercase font-bold text-accent">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            For your business
          </div>
        </div>
        
        <h3 class="font-display text-3xl lg:text-4xl mb-6">Growing businesses</h3>
        
        <p class="text-[1.05rem] font-medium text-foreground mb-12 leading-relaxed opacity-80">
          Keep your accounting moving while you focus on running and growing the business.
        </p>

        <!-- BENEFIT BULLETS -->
        <div class="flex-grow flex flex-col gap-7 mb-14">
          <div class="flex items-start gap-5">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-accent transition-transform duration-300 hover:scale-110">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <p class="text-[0.95rem] text-muted-foreground leading-relaxed">
              Accounting handled by an experienced team without building the entire function in-house.
            </p>
          </div>
          <div class="flex items-start gap-5">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-accent transition-transform duration-300 hover:scale-110">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <p class="text-[0.95rem] text-muted-foreground leading-relaxed">
              Accounting capacity that can grow with the business as the workload changes.
            </p>
          </div>
          <div class="flex items-start gap-5">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-accent transition-transform duration-300 hover:scale-110">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <p class="text-[0.95rem] text-muted-foreground leading-relaxed">
              More internal time and attention for sales, operations and growth.
            </p>
          </div>
        </div>

        <div class="mt-auto pt-8" style="border-top: 1px solid rgba(0,0,0,0.07)">
          <div class="text-[1.05rem] font-medium text-foreground leading-relaxed mb-8">
            Accounting gets handled without building the entire function internally.
          </div>
          <a href="/businesses" class="group inline-flex items-center text-[11px] tracking-[0.18em] font-bold uppercase text-foreground hover:text-accent transition-colors duration-300 clay-btn rounded-full px-6 py-3.5">
            See how it works for businesses 
            <span class="ml-3 transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!-- CARD B: ACCOUNTING FIRMS -->
      <div class="reveal flex flex-col rounded-[2.5rem] bg-background p-10 lg:p-14 clay-card border border-white/50 hover:-translate-y-2 transition-transform duration-500 delay-100 cursor-default">
        
        <div class="flex justify-between items-center mb-10">
          <div class="flex items-center gap-2 bg-background clay-pressed px-5 py-2 rounded-full text-[9px] tracking-widest uppercase font-bold text-forest">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            For your clients
          </div>
        </div>
        
        <h3 class="font-display text-3xl lg:text-4xl mb-6">Finance & accounting firms</h3>
        
        <p class="text-[1.05rem] font-medium text-foreground mb-12 leading-relaxed opacity-80">
          Extend your accounting delivery capacity without extending your internal team at the same rate.
        </p>

        <!-- BENEFIT BULLETS -->
        <div class="flex-grow flex flex-col gap-7 mb-14">
          <div class="flex items-start gap-5">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-forest transition-transform duration-300 hover:scale-110">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <p class="text-[0.95rem] text-muted-foreground leading-relaxed">
              Additional accounting delivery capacity behind your existing team.
            </p>
          </div>
          <div class="flex items-start gap-5">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-forest transition-transform duration-300 hover:scale-110">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <p class="text-[0.95rem] text-muted-foreground leading-relaxed">
              More senior time for finance, advisory and client relationships.
            </p>
          </div>
          <div class="flex items-start gap-5">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-forest transition-transform duration-300 hover:scale-110">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <p class="text-[0.95rem] text-muted-foreground leading-relaxed">
              Serve more client work without hiring for every additional requirement.
            </p>
          </div>
        </div>

        <div class="mt-auto pt-8" style="border-top: 1px solid rgba(0,0,0,0.07)">
          <div class="text-[1.05rem] font-medium text-foreground leading-relaxed mb-8">
            You keep the client relationship. We stay in the accounting delivery layer.
          </div>
          <a href="/partners" class="group inline-flex items-center text-[11px] tracking-[0.18em] font-bold uppercase text-foreground hover:text-forest transition-colors duration-300 clay-btn rounded-full px-6 py-3.5">
            See how it works for partners 
            <span class="ml-3 transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .clay-card {
    box-shadow: 20px 20px 40px #c4c6cc, -20px -20px 40px #ffffff;
  }

  .clay-btn {
    box-shadow: 8px 8px 16px #c4c6cc, -8px -8px 16px #ffffff;
  }

  .clay-pressed {
    box-shadow: inset 6px 6px 12px #c4c6cc, inset -6px -6px 12px #ffffff;
  }
</style>

<section id="founders" class="bg-background py-[130px] scroll-mt-[90px] border-b border-hairline max-[760px]:py-[75px]">
  <div class="shell">
    <div class="reveal">
      <div class="eyebrow flex items-center gap-3 text-muted-foreground">
        <span aria-hidden="true" class="inline-block size-[6px] rotate-45 bg-accent"></span>
        The people you'll actually deal with
      </div>
      <h2 class="display-lg mt-8 max-w-[800px]">Experienced people.<br>Personally invested.</h2>
      <p class="max-w-[650px] text-[1.05rem] text-muted-foreground leading-relaxed mt-10">Founded in Ahmedabad by Helly Shah, Calveris Global brings hands-on accounting experience and personal ownership to your everyday finance work.</p>
    </div>
    
    <div class="grid grid-cols-2 items-center gap-[100px] mt-[70px] max-[1050px]:gap-[50px] max-[760px]:grid-cols-1 max-[760px]:gap-[40px] max-[760px]:mt-[45px]">
      <div class="reveal max-[760px]:max-w-[470px] group" style="animation-delay: 140ms">
        <div class="overflow-hidden bg-secondary">
          <img src="/images/img-2.jpeg" alt="Helly Shah, Founder of Calveris Global" width="912" height="1104" loading="lazy" class="block w-full h-auto max-h-[620px] aspect-[4/5] object-cover object-[center_20%] transition-transform duration-[1200ms] group-hover:scale-[1.025]">
        </div>
      </div>
      <div class="reveal" style="animation-delay: 280ms">
        <div class="eyebrow text-accent">Founder · ACCA</div>
        <h3 class="font-display font-light text-[60px] leading-[1.02] tracking-[-0.025em] mb-[30px] max-[760px]:text-[48px]">Helly Shah</h3>
        <p class="text-[14px] text-muted-foreground mb-[25px] leading-relaxed">Helly has built and led accounting delivery for UK, US and international clients. At Calveris Global, she brings that experience to a simple goal: dependable finance support that feels like part of your own team.</p>
        <p class="text-[14px] text-muted-foreground mb-[25px] leading-relaxed">For businesses, we take care of everyday accounting and finance tasks. For accountancy firms, we add the capacity to manage client work and deadlines. Your priorities shape the team, the scope and the way we work together.</p>
        <a class="eyebrow mt-8 inline-flex items-center gap-3 border border-foreground/25 px-6 py-3 tracking-[0.18em] transition-colors duration-500 hover:bg-ink hover:text-ink-foreground" href="https://wa.me/447999901081" target="_blank" rel="noopener">
          Talk to our team <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    
    <p class="text-[12px] text-muted-foreground mt-[35px] tracking-[0.04em]">
      <b class="text-inherit font-semibold">Direct communication.</b> Agreed check-ins. People who know your priorities.
    </p>
  </div>
</section>

<section class="bg-forest text-forest-foreground py-[130px] scroll-mt-[90px] border-b border-hairline-light max-[760px]:py-[75px]" id="drip">
  <div class="shell flex justify-between items-center gap-[60px] max-[760px]:block">
    <div class="reveal">
      <div class="eyebrow flex items-center gap-3 text-forest-foreground/60">
        <span aria-hidden="true" class="inline-block size-[6px] rotate-45 bg-accent"></span>
        A conversation, not a commitment
      </div>
      <h2 class="display-lg mt-8 mb-[26px]">Let’s give your business<br>more room to grow.</h2>
      <p class="text-forest-foreground/75 max-w-[650px] leading-relaxed text-[1.05rem]">Share your priorities. We’ll help you shape the right support.</p>
    </div>
    <div class="reveal" style="animation-delay: 140ms">
      <a class="group inline-flex items-center gap-3 border px-7 py-4 eyebrow tracking-[0.18em] transition-colors duration-500 border-background bg-background text-ink hover:bg-accent hover:border-accent hover:text-accent-foreground shrink-0 max-[760px]:mt-[30px]" href="mailto:info@calveris.co.uk?subject=Calveris%20capacity%20enquiry">
        <span>Start a conversation</span>
        <span class="transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-0.5"><svg viewBox="0 0 16 16" class="size-3.5" fill="none" aria-hidden="true"><path d="M2.5 8h11M9.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg></span>
      </a>
    </div>
  </div>
</section>

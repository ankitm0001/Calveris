---
---

<section id="pilot" class="bg-background py-24 lg:py-32 border-b border-hairline overflow-hidden">
  <div class="shell grid gap-16 lg:gap-20 lg:grid-cols-2 items-start">
    
    <!-- LEFT COLUMN -->
    <div class="pr-0 lg:pr-8 relative reveal">
      <div class="flex items-center gap-3 text-[11px] tracking-[0.18em] text-accent font-semibold mb-8 uppercase lg:-mt-[52px]">
        <span aria-hidden="true" class="inline-block size-[6px] rotate-45 bg-accent"></span>
        Before you commit
      </div>
      <h2 class="display-lg mb-8 max-w-md text-balance text-foreground">
        Test our delivery before you commit.
      </h2>
      <p class="text-[17px] text-muted-foreground leading-relaxed max-w-md">
        Start with a real accounting requirement. We'll complete up to 10 hours of work so you can evaluate the quality, communication and delivery before deciding how you want to proceed.
      </p>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="relative reveal flex flex-col items-center lg:items-start text-center">
      <div class="flex flex-col items-center w-full max-w-sm mx-auto lg:mx-0 lg:ml-auto lg:mr-12">
        
        <!-- Stage 01 -->
        <div class="flex flex-col items-center">
          <h3 class="text-[13px] uppercase tracking-[0.1em] font-semibold text-foreground mb-1.5">Your real accounting requirement</h3>
          <p class="text-[14px] text-muted-foreground">Share a suitable piece of accounting work.</p>
        </div>
        
        <div class="py-5">
          <span class="text-muted-foreground/60 text-[20px]">↓</span>
        </div>

        <!-- Stage 02 -->
        <div class="flex flex-col items-center">
          <h3 class="text-[14px] uppercase tracking-[0.15em] font-bold text-foreground mb-1.5">Up to 10 hours of delivery</h3>
          <p class="text-[15px] text-foreground/90 font-medium">Our team completes the agreed accounting work.</p>
        </div>
        
        <div class="py-5">
          <span class="text-muted-foreground/60 text-[20px]">↓</span>
        </div>

        <!-- Stage 03 -->
        <div class="flex flex-col items-center">
          <h3 class="text-[13px] uppercase tracking-[0.1em] font-semibold text-foreground mb-1.5">Review the result</h3>
          <p class="text-[14px] text-muted-foreground">Evaluate the quality, communication and delivery.</p>
        </div>
        
        <div class="py-5">
          <span class="text-muted-foreground/60 text-[20px]">↓</span>
        </div>

        <!-- Stage 04 -->
        <div class="flex flex-col items-center">
          <h3 class="text-[13px] uppercase tracking-[0.1em] font-semibold text-foreground mb-1.5">Decide with evidence</h3>
          <p class="text-[14px] text-muted-foreground">Continue when you're confident the delivery model works for you.</p>
        </div>

      </div>

      <div class="mt-16 text-[12px] text-muted-foreground/60 italic border-t border-hairline pt-6 max-w-sm w-full text-center mx-auto lg:mx-0 lg:ml-auto lg:mr-12">
        *Available for eligible engagements. Scope and eligibility depend on the nature and volume of work. Full terms apply.
      </div>
    </div>

  </div>
</section>

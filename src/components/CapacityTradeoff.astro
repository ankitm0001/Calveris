---
---

<section id="capacity-tradeoff" class="bg-background pt-16 pb-32">
  <div class="shell">
    <div class="text-center max-w-4xl mx-auto mb-20">
      <h2 class="display-lg text-balance mb-6 leading-[1.1]">
        Build the capacity internally,<br /> or add it externally?
      </h2>
      <p class="text-muted-foreground max-w-2xl mx-auto text-[1.05rem]">
        Both can increase the capacity available to the business.<br />
        They come with different commitments.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 relative">

      <!-- Left Card: Build Internally -->
      <div class="tradeoff-card group/box relative rounded-[2.5rem] bg-background p-10 lg:p-12 clay-card border border-white/50 flex flex-col hover:-translate-y-2 transition-all duration-500 cursor-default">
        <!-- Header -->
        <div class="flex justify-between items-center mb-14">
          <h3 class="text-[11px] tracking-[0.22em] uppercase font-bold text-muted-foreground">Build Internally</h3>
          <div class="flex items-center gap-2 bg-background clay-pressed px-5 py-2 rounded-full text-[9px] tracking-widest uppercase font-bold text-[#c96a4a]">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Absorbs Resources
          </div>
        </div>
        <!-- List -->
        <ul class="space-y-7 flex-1">
          <li class="flex gap-5 text-muted-foreground text-[0.9rem] font-medium items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-[#c96a4a] group-hover/box:scale-110 transition-transform duration-300">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <span class="leading-relaxed">Recruitment time and cost before capacity is available</span>
          </li>
          <li class="flex gap-5 text-muted-foreground text-[0.9rem] font-medium items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-[#c96a4a] group-hover/box:scale-110 transition-transform duration-300">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <span class="leading-relaxed">Salary and management overhead</span>
          </li>
          <li class="flex gap-5 text-muted-foreground text-[0.9rem] font-medium items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-[#c96a4a] group-hover/box:scale-110 transition-transform duration-300">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <span class="leading-relaxed">Reliance on individual hires</span>
          </li>
          <li class="flex gap-5 text-muted-foreground text-[0.9rem] font-medium items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full clay-btn bg-background flex items-center justify-center shrink-0 text-[#c96a4a] group-hover/box:scale-110 transition-transform duration-300">
              <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            </div>
            <span class="leading-relaxed">Senior time spent managing operational finance</span>
          </li>
        </ul>
      </div>

      <!-- Right Card: Add Calveris -->
      <div class="tradeoff-card group/box relative rounded-[2.5rem] dark-card p-10 lg:p-12 overflow-hidden text-white flex flex-col hover:-translate-y-2 transition-all duration-500 cursor-default">
        <!-- Glowing blobs -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-[#2a5a4a] rounded-full blur-[100px] opacity-40 -translate-y-1/2 translate-x-1/3 pointer-events-none group-hover/box:opacity-60 transition-opacity duration-500"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-[#1b3a2f] rounded-full blur-[80px] opacity-50 translate-y-1/3 -translate-x-1/3 pointer-events-none"></div>

        <!-- Header -->
        <div class="flex justify-between items-center mb-14 relative z-10">
          <h3 class="text-[11px] tracking-[0.22em] uppercase font-bold text-white">Add Calveris</h3>
          <div class="flex items-center gap-2 bg-[#2a5a4a]/20 text-[#a3c2a3] border border-[#a3c2a3]/30 px-5 py-2 rounded-full text-[9px] tracking-widest uppercase font-bold backdrop-blur-md">
            Preserves Resources
          </div>
        </div>

        <!-- List -->
        <ul class="space-y-7 flex-1 relative z-10">
          <li class="flex gap-5 text-[#d1d5db] text-[0.9rem] font-light items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-[#2a5a4a] shadow-[0_0_15px_rgba(42,90,74,0.8)] text-white flex items-center justify-center shrink-0 border border-[#48826d] group-hover/box:scale-110 transition-transform duration-300">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="leading-relaxed">Capacity without starting a hiring cycle</span>
          </li>
          <li class="flex gap-5 text-[#d1d5db] text-[0.9rem] font-light items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-[#2a5a4a] shadow-[0_0_15px_rgba(42,90,74,0.8)] text-white flex items-center justify-center shrink-0 border border-[#48826d] group-hover/box:scale-110 transition-transform duration-300">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="leading-relaxed">Capacity matched to the engagement</span>
          </li>
          <li class="flex gap-5 text-[#d1d5db] text-[0.9rem] font-light items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-[#2a5a4a] shadow-[0_0_15px_rgba(42,90,74,0.8)] text-white flex items-center justify-center shrink-0 border border-[#48826d] group-hover/box:scale-110 transition-transform duration-300">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="leading-relaxed">Access to a wider delivery team</span>
          </li>
          <li class="flex gap-5 text-[#d1d5db] text-[0.9rem] font-light items-start">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-[#2a5a4a] shadow-[0_0_15px_rgba(42,90,74,0.8)] text-white flex items-center justify-center shrink-0 border border-[#48826d] group-hover/box:scale-110 transition-transform duration-300">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="leading-relaxed">Senior time available for higher-value work</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- CTA -->
    <div class="max-w-3xl mx-auto text-center mt-14">
      <a
        href="/contact"
        class="inline-flex items-center gap-3 group clay-btn rounded-full px-8 py-4 text-[10px] font-bold tracking-[0.2em] uppercase text-foreground hover:-translate-y-0.5 transition-all duration-300"
      >
        See what Calveris provides
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .clay-card {
    box-shadow: 20px 20px 40px #c4c6cc, -20px -20px 40px #ffffff;
  }

  .clay-btn {
    box-shadow: 8px 8px 16px #c4c6cc, -8px -8px 16px #ffffff;
  }

  .clay-pressed {
    box-shadow: inset 6px 6px 12px #c4c6cc, inset -6px -6px 12px #ffffff;
  }

  .dark-card {
    background-color: #06100c;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
</style>
